---
import { Image } from 'astro:assets';
// You will import your logo here once you add it to the project!
// Example: import mainLogo from '../assets/logo.png';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>45 Minute Media</title>
    <style>
      :root {
        /* Your Professional Minimalist Palette */
        --color-bg: #FFFFFF;      /* Pure White */
        --color-text: #1A1A1A;    /* Soft Black for better readability */
        --color-accent: #0056b3;  /* Professional Sharp Blue */
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }

      .container {
        text-align: center;
        max-width: 800px;
        padding: 2rem;
      }

      h1 {
        font-size: 3.5rem;
        font-weight: 200; /* Thin font for that modern, minimal feel */
        letter-spacing: -0.05em;
        margin-bottom: 0.5rem;
      }

      .accent {
        color: var(--color-accent);
        font-weight: 500;
      }

      p {
        font-size: 1.2rem;
        color: #666666; /* Gray for subtitles */
        font-weight: 300;
      }
    </style>
  </head>
  <body>
    <main class="container">
      <!-- Your logo will go right here -->
      <h1>45 Minute <span class="accent">Media</span></h1>
      <p>Professional video production, streamlined.</p>
    </main>
  </body>
</html>