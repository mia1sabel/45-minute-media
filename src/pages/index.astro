---
import { Image } from 'astro:assets';
import mainLogo from '../assets/1.png';
import faviconImg from '../assets/3.svg';

// Clean trailing slash to prevent broken paths like //website-vid.mp4
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const onboardingUrl = `${base}/onboarding`; 
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Founder Frame | Get More Clients By Just Being You</title>

    <!-- Canonical & Social Metadata -->
    <link rel="canonical" href="https://founderframe.com" />
    <meta property="og:url" content="https://founderframe.com" />
    <meta property="og:title" content="Founder Frame | Get More Clients By Just Being You" />
    <meta property="og:description" content="For Atlanta businesses that know having an audience, is the marketing." />

    <style>
      @font-face {
        font-family: 'Le Jour Serif';
        src: url('/fonts/le-jour.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg-color: #F8F3E9;
        --surface-color: #FFFFFF;
        --text-main: #000000;
        --text-muted: #555555;
        --accent: #000000;
        --border-color: #BEB3A3;
      }

      html {
        scroll-behavior: smooth;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Le Jour Serif', Georgia, serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }
      
      /* Header completely flush left */
      header {
        position: relative;
        background-color: transparent;
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 2rem 1rem 0; width: 100%;
        border-bottom: 1.5px solid var(--border-color);
      }
      .logo { display: flex; align-items: center; text-decoration: none; margin-left: 0; }
      .logo img { height: 90px; width: auto; object-fit: contain; display: block; }

      nav { display: flex; gap: 2rem; align-items: center; font-family: system-ui, -apple-system, sans-serif; }
      nav a {
        text-decoration: none; color: var(--text-muted); font-weight: 500;
        font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.2s ease;
      }
      nav a:hover { color: var(--text-main); }

      /* Hero Section */
      .hero {
        padding: 4.5rem 5% 4rem; text-align: center;
        display: flex; flex-direction: column; align-items: center;
        scroll-margin-top: 20px;
      }
      .hero-content { max-width: 100%; width: 100%; }
      
      h1 {
        font-size: clamp(1.7rem, 2.7vw, 3.2rem);
        font-weight: 400; line-height: 1.15;
        letter-spacing: -0.01em; margin-bottom: 1.5rem; color: var(--text-main);
        white-space: nowrap;
        text-align: center;
        width: 100%;
      }

      p.subtitle {
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--text-muted); margin-bottom: 2rem;
        line-height: 1.6; max-width: 700px; margin-inline: auto; font-weight: 300;
      }
      
      .cta-btn {
        display: inline-block; background-color: var(--text-main); color: var(--bg-color);
        padding: 1rem 2.5rem; border-radius: 4px; text-decoration: none;
        font-family: system-ui, -apple-system, sans-serif;
        font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em;
        transition: opacity 0.2s ease, transform 0.1s ease;
      }
      .cta-btn:hover { opacity: 0.9; transform: translateY(-1px); }

      /* Section Divider */
      .cta-divider {
        width: 100%; max-width: 1400px; height: 1.5px;
        background-color: var(--border-color); margin: 3rem auto 4rem;
      }

      /* How It Works Section */
      .how-it-works-section {
        width: 100%; max-width: 1300px; margin: 0 auto 4rem;
        padding: 0 2rem;
      }

      .how-it-works-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
        align-items: center;
        max-width: 1100px;
        margin: 0 auto;
      }
      @media (min-width: 900px) {
        .how-it-works-grid {
          grid-template-columns: 1.3fr 0.7fr;
        }
      }

      /* Black box wrapping only the text side */
      .steps-container {
        display: flex; flex-direction: column; width: 100%;
        background-color: var(--text-main);
        color: var(--bg-color);
        border-radius: 12px;
        padding: 3rem 3.5rem;
        box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.15);
      }

      .section-tag {
        font-size: 0.85rem; font-family: system-ui, -apple-system, sans-serif; font-weight: 600; color: var(--bg-color);
        letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1.5rem;
      }
      
      .step-item {
        display: flex; gap: 2rem; align-items: flex-start;
        padding-top: 1.25rem; padding-bottom: 1.25rem;
        border-top: 1.5px solid #333333; width: 100%;
      }
      .step-item:last-child {
        border-bottom: 1.5px solid #333333;
      }
      .step-number {
        font-size: 1.25rem; font-family: system-ui, -apple-system, sans-serif; font-weight: 400; color: var(--bg-color);
        min-width: 2rem;
      }
      .step-content { flex: 1; }
      
      .step-content h3 {
        font-family: 'Le Jour Serif', Georgia, serif;
        font-size: 1.4rem;
        font-weight: normal;
        color: var(--bg-color);
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
      }
      
      .step-content p {
        color: var(--bg-color);
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 1.05rem;
        line-height: 1.5;
        font-weight: 300;
      }

      .how-it-works-image-wrapper {
        display: flex; justify-content: center; align-items: center; width: 100%;
      }
      .how-it-works-placeholder {
        width: 100%; max-width: 280px; aspect-ratio: 9/16;
        background: #111; border-radius: 8px; overflow: hidden;
        box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.15);
      }

      /* Bold, Standout Video Showcase Section */
      .video-showcase-section {
        width: 100%; max-width: 100%; margin: 0 auto 4rem;
        padding: 0 2rem; text-align: center;
      }

      .section-heading-group {
        margin-bottom: 3.5rem; text-align: center; width: 100%;
      }
      .showcase-main-title {
        font-family: 'Le Jour Serif', Georgia, serif;
        font-size: clamp(2rem, 3.2vw, 3.6rem);
        font-weight: 400;
        line-height: 1.15;
        color: var(--text-main);
        letter-spacing: -0.01em;
        margin-bottom: 1.5rem;
        white-space: nowrap;
        text-align: center;
        width: 100%;
      }
      .showcase-main-desc {
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--text-muted);
        font-weight: 300;
        text-align: center;
      }

      .video-showcase-grid {
        display: grid; grid-template-columns: 1fr; gap: 2rem; justify-items: center; max-width: 1300px; margin: 0 auto;
      }
      @media (min-width: 768px) {
        .video-showcase-grid { grid-template-columns: repeat(3, 1fr); }
      }
      
      .video-showcase-card {
        display: flex; flex-direction: column; align-items: center; gap: 0.75rem; width: 100%;
      }

      .video-placeholder {
        width: 100%; max-width: 280px; aspect-ratio: 9/16;
        background: #111; border-radius: 8px; overflow: hidden;
        box-shadow: 0 10px 24px -6px rgba(0, 0, 0, 0.15);
      }

      .video-card-caption {
        font-size: 0.75rem; font-family: system-ui, -apple-system, sans-serif;
        color: var(--text-muted); font-weight: 300; line-height: 1.4; max-width: 240px; text-align: center;
      }

      /* Contact / Get Started Section */
      .contact-section {
        padding: 4rem 5% 6rem;
        display: flex;
        justify-content: center;
        scroll-margin-top: 20px;
        background-color: var(--bg-color);
      }
      .container { max-width: 800px; width: 100%; }

      /* Centered Blueprint Banner Card */
      .offer-banner {
        background-color: var(--text-main); color: var(--bg-color); border-radius: 12px;
        padding: 3.5rem 3rem; text-align: center;
        box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.15);
        display: flex; flex-direction: column; align-items: center; gap: 1.5rem;
      }
      .offer-title { font-size: 2.25rem; font-weight: 400; letter-spacing: -0.01em; }
      .offer-text { font-size: 1.1rem; font-family: system-ui, -apple-system, sans-serif; color: #CCCCCC; line-height: 1.6; font-weight: 300; max-width: 600px; }
      .offer-text strong { color: #FFFFFF; font-weight: 500; }

      .banner-cta-btn {
        display: inline-block; background-color: var(--bg-color); color: var(--text-main);
        padding: 1rem 2.5rem; border-radius: 4px; text-decoration: none;
        font-family: system-ui, -apple-system, sans-serif;
        font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em;
        transition: opacity 0.2s ease, transform 0.1s ease;
      }
      .banner-cta-btn:hover { opacity: 0.9; transform: translateY(-1px); }

      /* Footer */
      footer {
        background-color: var(--text-main); color: #888888; padding: 4rem 2rem 3rem 0;
        width: 100%; margin-top: auto; font-family: system-ui, -apple-system, sans-serif;
        border-top: 1.5px solid #222222;
      }
      .footer-inner {
        max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem; padding-left: 0;
      }
      .footer-brand { padding-left: 0; }
      .footer-brand .footer-logo img { height: 90px; width: auto; display: block; margin-bottom: 1.25rem; filter: invert(1); }
      .footer-tagline { font-size: 1rem; color: #AAAAAA; margin-bottom: 0.5rem; font-weight: 300; margin-left: 1.5rem; }
      .footer-email { font-size: 1rem; color: #FFFFFF; text-decoration: none; font-weight: 400; transition: opacity 0.2s; display: inline-block; margin-left: 1.5rem; }
      .footer-email:hover { opacity: 0.8; }
      .footer-divider { height: 1.5px; background-color: #333333; width: 100%; }
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.9rem; padding-left: 0;
      }
      .footer-socials { display: flex; gap: 1.25rem; align-items: center; }
      .footer-socials a { color: #AAAAAA; transition: color 0.2s ease; display: flex; align-items: center; }
      .footer-socials a:hover { color: #FFF; }
      .footer-socials svg { width: 20px; height: 20px; fill: currentColor; }
      .copyright { color: #777777; margin-left: 1.5rem; }

      /* Mobile Fixes */
      @media (max-width: 1200px) {
        .showcase-main-title, h1 { white-space: normal; }
      }
      @media (max-width: 640px) {
        header {
          flex-direction: column;
          gap: 1rem;
          padding: 1rem 2%;
        }
        .logo img { height: 60px; }
        .footer-tagline, .footer-email, .copyright { margin-left: 0; }
        .hero {
          padding: 3rem 5% 2.5rem;
        }
        .offer-banner, .steps-container {
          padding: 2rem 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="#home" class="logo"><Image src={mainLogo} alt="Founder Frame" /></a>
      <nav>
        <a href={onboardingUrl} target="_blank" rel="noopener noreferrer">Get Started</a>
      </nav>
    </header>

    <main>
      <!-- Section 1: Home / Hero -->
      <section id="home" class="hero">
        <div class="hero-content">
          <h1>
            <span class="line-1">Get More Clients By Just Being You.</span>
          </h1>
          <p class="subtitle">
            For Atlanta businesses that know having an audience, is the marketing.
          </p>
          <a href={onboardingUrl} target="_blank" rel="noopener noreferrer" class="cta-btn">See If You Qualify</a>
        </div>
      </section>

      <!-- Section Separator -->
      <div class="cta-divider"></div>

      <!-- How It Works Section -->
      <section class="how-it-works-section">
        <div class="how-it-works-grid">
          <div class="steps-container">
            <p class="section-tag">HOW IT WORKS</p>

            <div class="step-item">
              <span class="step-number">01</span>
              <div class="step-content">
                <h3>We film with you once</h3>
                <p>And set up your phone so shooting is easy.</p>
              </div>
            </div>

            <div class="step-item">
              <span class="step-number">02</span>
              <div class="step-content">
                <h3>You press record</h3>
                <p>On your own time using the scripts we write for you.</p>
              </div>
            </div>

            <div class="step-item">
              <span class="step-number">03</span>
              <div class="step-content">
                <h3>We do all the hard work</h3>
                <p>Writing, editing, and posting every single video for you.</p>
              </div>
            </div>
          </div>

          <div class="how-it-works-image-wrapper">
            <div class="how-it-works-placeholder">
              <video autoplay loop muted playsinline preload="auto" style="width:100%; height:100%; object-fit:cover;">
                <source src={`${base}/website-vid.mp4`} type="video/mp4" />
              </video>
            </div>
          </div>
        </div>
      </section>

      <!-- 3 Small Video Placeholders Section (Divider removed above) -->
      <section class="video-showcase-section">
        <div class="section-heading-group">
          <h2 class="showcase-main-title">
            Premium Scripting. Premium Editing. Premium Results.
          </h2>
          <p class="showcase-main-desc">We plan, edit, and post all your content.</p>
        </div>

        <div class="video-showcase-grid">
          <!-- Video Card 1 -->
          <div class="video-showcase-card">
            <div class="video-placeholder">
              <video autoplay loop muted playsinline preload="auto" style="width:100%; height:100%; object-fit:cover;">
                <source src={`${base}/website-vid.mp4`} type="video/mp4" />
              </video>
            </div>
            <p class="video-card-caption">Sample video caption or project detail 01</p>
          </div>

          <!-- Video Card 2 -->
          <div class="video-showcase-card">
            <div class="video-placeholder">
              <video autoplay loop muted playsinline preload="auto" style="width:100%; height:100%; object-fit:cover;">
                <source src={`${base}/website-vid.mp4`} type="video/mp4" />
              </video>
            </div>
            <p class="video-card-caption">Sample video caption or project detail 02</p>
          </div>

          <!-- Video Card 3 -->
          <div class="video-showcase-card">
            <div class="video-placeholder">
              <video autoplay loop muted playsinline preload="auto" style="width:100%; height:100%; object-fit:cover;">
                <source src={`${base}/website-vid.mp4`} type="video/mp4" />
              </video>
            </div>
            <p class="video-card-caption">Sample video caption or project detail 03</p>
          </div>
        </div>
      </section>

      <!-- Section 2: Get Started / Contact (Divider removed above) -->
      <section id="contact" class="contact-section">
        <div class="container">
          <!-- Centered Offer Banner Card -->
          <div class="offer-banner">
            <h3 class="offer-title">Get Your Free Blueprint</h3>
            <a href={onboardingUrl} target="_blank" rel="noopener noreferrer" class="banner-cta-btn">Start Your Personal Brand</a>
            <p class="offer-text">
              To give every brand our full attention, we only work with 4 clients at a time. <strong>Fill out the form to get your free blueprint.</strong>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="#home" class="footer-logo"><Image src={mainLogo} alt="Founder Frame" /></a>
          <p class="footer-tagline">For Atlanta businesses that know having an audience, is the marketing.</p>
          <a href="mailto:fndrframe@gmail.com" class="footer-email">fndrframe@gmail.com</a>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <p class="copyright">&copy; 2026 Founder Frame. All rights reserved.</p>
          <div class="footer-socials">
            <a href="https://www.instagram.com/fnderframe?psln=YzhucXl0ajZmYjJn&utm_source=qr" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@fnderframe?_r=1&_t=ZP-9BBSC2ZFyyl" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.34-6.34V9.05a8.16 8.16 0 0 0 4.91 1.61V7.22a4.85 4.85 0 0 1-1-.53z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>