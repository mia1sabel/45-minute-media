---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>45-Minute Media | Video Production</title>
    <style>
      :root {
        --bg-color: #FAFAFA;
        --text-main: #111827;
        --text-muted: #6B7280;
        --accent: #2563EB;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }
      
      /* Header & Nav */
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 2rem 5%; max-width: 1400px; margin: 0 auto; width: 100%;
      }
      .logo img { height: 42px; width: auto; }
      nav { display: flex; gap: 2.5rem; }
      nav a {
        text-decoration: none; color: var(--text-muted); font-weight: 500;
        font-size: 0.95rem; transition: color 0.2s ease;
      }
      nav a:hover, nav a.active { color: var(--text-main); }

      /* Hero Section */
      main {
        flex: 1; display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        padding: 4rem 5%; text-align: center;
      }
      .hero-content { max-width: 900px; }
      h1 {
        font-size: clamp(2.5rem, 5vw, 4.5rem);
        font-weight: 700; line-height: 1.1;
        letter-spacing: -0.03em; margin-bottom: 1.5rem; color: #000;
      }
      p.subtitle {
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        color: var(--text-muted); margin-bottom: 3rem;
        line-height: 1.6; max-width: 700px; margin-inline: auto;
      }
      
      /* CTA Button */
      .cta-btn {
        display: inline-block; background-color: var(--text-main); color: #FFF;
        padding: 1rem 2.5rem; border-radius: 50px; text-decoration: none;
        font-weight: 600; font-size: 1.05rem;
        transition: transform 0.2s ease, background-color 0.2s ease;
      }
      .cta-btn:hover { background-color: #000; transform: translateY(-2px); }

      footer {
        text-align: center; padding: 3rem 5%; font-size: 0.875rem;
        color: var(--text-muted);
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href="/" class="active">Home</a>
        <a href="/work">Work</a>
        <a href="/contact">Get Started</a>
      </nav>
    </header>

    <main>
      <div class="hero-content">
        <h1>Video production for brands who'd rather be running their business.</h1>
        <p class="subtitle">
          We've streamlined the entire production process. You give us the vision; we handle the logistics, lighting, sound, and editing to deliver premium corporate messaging and brand storytelling.
        </p>
        <a href="/contact" class="cta-btn">Start a Project</a>
      </div>
    </main>

    <footer>
      <p>&copy; 2026 45-Minute Media. All rights reserved.</p>
    </footer>
  </body>
</html>