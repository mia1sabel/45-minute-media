---
import { Image } from 'astro:assets';
import mainLogo from '../assets/1.png';
import faviconImg from '../assets/3.png';

// Clean trailing slash to prevent broken paths like //website-vid.mp4
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Founder Frame | Get More Clients By Just Being You</title>

    <!-- Canonical & Social Metadata -->
    <link rel="canonical" href="https://founderframe.com" />
    <meta property="og:url" content="https://founderframe.com" />
    <meta property="og:title" content="Founder Frame | Get More Clients By Just Being You" />
    <meta property="og:description" content="For Atlanta businesses that know having an audience, is the marketing." />

    <style>
      @font-face {
        font-family: 'Le Jour Serif';
        src: url('/fonts/Le Jour Serif Persona.otf') format('opentype');
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --bg-color: #F8F3E9;
        --surface-color: #FFFFFF;
        --text-main: #000000;
        --text-muted: #555555;
        --accent: #000000;
        --border-color: #E2DBD0;
      }

      html {
        scroll-behavior: smooth;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Le Jour Serif', Georgia, serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }
      
      /* Static Header with Prominent Logo */
      header {
        position: relative;
        background-color: transparent;
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.5rem 5%; width: 100%; max-width: 1400px; margin: 0 auto;
        border-bottom: 1px solid var(--border-color);
      }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 180px; width: auto; object-fit: contain; } /* Massively increased size */

      nav { display: flex; gap: 2rem; align-items: center; font-family: system-ui, -apple-system, sans-serif; }
      nav a {
        text-decoration: none; color: var(--text-muted); font-weight: 500;
        font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; transition: color 0.2s ease;
      }
      nav a:hover { color: var(--text-main); }

      /* Hero Section */
      .hero {
        padding: 5rem 5% 4rem; text-align: center;
        display: flex; flex-direction: column; align-items: center;
        scroll-margin-top: 20px;
      }
      .hero-content { max-width: 1100px; width: 100%; }
      
      h1 {
        font-size: clamp(2.5rem, 4.5vw, 4.2rem);
        font-weight: 400; line-height: 1.15;
        letter-spacing: -0.01em; margin-bottom: 1.5rem; color: var(--text-main);
      }
      
      .line-1, .line-2 { display: block; }

      p.subtitle {
        font-size: clamp(1.15rem, 2vw, 1.4rem);
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--text-muted); margin-bottom: 2.5rem;
        line-height: 1.6; max-width: 700px; margin-inline: auto; font-weight: 300;
      }
      
      .cta-btn {
        display: inline-block; background-color: var(--text-main); color: var(--bg-color);
        padding: 1rem 2.5rem; border-radius: 4px; text-decoration: none;
        font-family: system-ui, -apple-system, sans-serif;
        font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em;
        transition: opacity 0.2s ease, transform 0.1s ease;
      }
      .cta-btn:hover { opacity: 0.9; transform: translateY(-1px); }

      /* Section Separator */
      .cta-divider {
        width: 100%; max-width: 1300px; height: 1px;
        background-color: var(--border-color); margin: 2rem auto 4rem;
      }

      /* How It Works Layout */
      .how-it-works-section {
        width: 100%; max-width: 1300px; margin: 0 auto 6rem;
        padding: 0 5%;
      }
      .how-it-works-grid {
        display: grid; grid-template-columns: 1fr; gap: 3.5rem; align-items: center;
      }
      @media (min-width: 900px) {
        .how-it-works-grid { grid-template-columns: 1.8fr 0.8fr; }
      }

      .section-tag {
        font-size: 0.85rem; font-family: system-ui, -apple-system, sans-serif; font-weight: 600; color: var(--text-muted);
        letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1rem;
      }
      .section-title {
        font-size: 2.75rem; font-weight: 400; letter-spacing: -0.01em; margin-bottom: 2.5rem;
      }
      
      .step-item {
        display: flex; gap: 2rem; align-items: flex-start;
        padding-top: 1.75rem; padding-bottom: 1.75rem;
        border-top: 1px solid var(--border-color); width: 100%;
      }
      .step-number {
        font-size: 1.25rem; font-family: system-ui, -apple-system, sans-serif; font-weight: 400; color: var(--text-muted);
        min-width: 2rem;
      }
      .step-content { flex: 1; }
      .step-content h3 { font-size: 1.5rem; font-weight: 400; margin-bottom: 0.35rem; color: var(--text-main); }
      .step-content p {
        color: var(--text-muted); font-family: system-ui, -apple-system, sans-serif; font-size: 1.05rem; line-height: 1.5;
        font-weight: 300;
      }

      /* Video Frame */
      .video-wrapper {
        width: 100%; max-width: 380px; margin: 0 auto;
        aspect-ratio: 9/16; background: #000; border-radius: 12px;
        overflow: hidden; box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.1);
      }
      .video-wrapper video {
        width: 100%; height: 100%; object-fit: cover; display: block;
      }

      /* Contact / Get Started Section */
      .contact-section {
        border-top: 1px solid var(--border-color);
        padding: 6rem 5%;
        display: flex;
        justify-content: center;
        scroll-margin-top: 20px;
        background-color: rgba(255, 255, 255, 0.4);
      }
      .container { max-width: 800px; width: 100%; }

      /* Banner Card */
      .offer-banner {
        background-color: var(--text-main); color: var(--bg-color); border-radius: 12px;
        padding: 3rem; margin-bottom: 2.5rem; text-align: left;
        box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.15);
      }
      .offer-badge {
        display: inline-link; background-color: var(--bg-color); color: var(--text-main);
        font-size: 0.75rem; font-family: system-ui, -apple-system, sans-serif; font-weight: 600; padding: 0.35rem 0.75rem;
        border-radius: 4px; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 1.25rem;
      }
      .offer-title { font-size: 2.25rem; font-weight: 400; margin-bottom: 0.75rem; letter-spacing: -0.01em; }
      .offer-text { font-size: 1.1rem; font-family: system-ui, -apple-system, sans-serif; color: #CCCCCC; line-height: 1.6; font-weight: 300; }

      /* Form Card */
      .form-card {
        background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 12px;
        padding: 3.5rem 3rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.03);
      }
      .form-card h2 { font-size: 2.5rem; font-weight: 400; margin-bottom: 2.25rem; letter-spacing: -0.01em; color: var(--text-main); }

      .form-group { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 1.5rem; text-align: left; }
      .form-group label { font-size: 0.9rem; font-family: system-ui, -apple-system, sans-serif; font-weight: 500; color: var(--text-main); text-transform: uppercase; letter-spacing: 0.05em; }
      .form-group input {
        padding: 1rem 1.25rem; border: 1px solid var(--border-color); border-radius: 6px;
        font-size: 1rem; font-family: system-ui, -apple-system, sans-serif; transition: border-color 0.2s, box-shadow 0.2s;
        outline: none; background-color: var(--bg-color);
      }
      .form-group input:focus { border-color: var(--text-main); background-color: #FFF; }

      .submit-btn {
        width: 100%; background-color: var(--text-main); color: var(--bg-color); border: none;
        padding: 1.15rem; border-radius: 6px; font-family: system-ui, -apple-system, sans-serif;
        font-weight: 500; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.08em;
        cursor: pointer; transition: opacity 0.2s ease, transform 0.1s ease; margin-top: 0.5rem;
      }
      .submit-btn:hover { opacity: 0.9; transform: translateY(-1px); }

      /* Footer */
      footer {
        background-color: var(--text-main); color: #888888; padding: 4rem 5% 3rem;
        width: 100%; margin-top: auto; font-family: system-ui, -apple-system, sans-serif;
      }
      .footer-inner {
        max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;
      }
      .footer-brand .footer-logo img { height: 140px; width: auto; display: block; margin-bottom: 1rem; filter: invert(1); } /* Larger footer logo */
      .footer-tagline { font-size: 1rem; color: #AAAAAA; margin-bottom: 0.5rem; font-weight: 300; }
      .footer-email { font-size: 1rem; color: #FFFFFF; text-decoration: none; font-weight: 400; transition: opacity 0.2s; }
      .footer-email:hover { opacity: 0.8; }
      .footer-divider { height: 1px; background-color: #222222; width: 100%; }
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.9rem;
      }
      .footer-socials { display: flex; gap: 1.25rem; align-items: center; }
      .footer-socials a { color: #AAAAAA; transition: color 0.2s ease; display: flex; align-items: center; }
      .footer-socials a:hover { color: #FFF; }
      .footer-socials svg { width: 20px; height: 20px; fill: currentColor; }
      .copyright { color: #777777; }

      /* Mobile Fixes */
      @media (max-width: 640px) {
        header {
          flex-direction: column;
          gap: 1rem;
          padding: 1rem 5%;
        }
        .logo img { height: 140px; }
        .hero {
          padding: 3rem 5% 2.5rem;
        }
        .offer-banner {
          padding: 2rem 1.5rem;
        }
        .form-card {
          padding: 2rem 1.5rem;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="#home" class="logo"><Image src={mainLogo} alt="Founder Frame" /></a>
      <nav>
        <a href="#home">Home</a>
        <a href="#contact">Get Started</a>
      </nav>
    </header>

    <main>
      <!-- Section 1: Home / Hero -->
      <section id="home" class="hero">
        <div class="hero-content">
          <h1>
            <span class="line-1">Get More Clients By Just Being You.</span>
          </h1>
          <p class="subtitle">
            For Atlanta businesses that know having an audience, is the marketing.
          </p>
          <a href="#contact" class="cta-btn">See If You Qualify</a>
        </div>
      </section>

      <div class="cta-divider"></div>

      <!-- How It Works -->
      <section class="how-it-works-section">
        <div class="how-it-works-grid">
          <div class="steps-column">
            <p class="section-tag">HOW IT WORKS</p>
            <h2 class="section-title">Premium Scripting. Premium Editing. Premium Results.</h2>
            
            <div class="step-item">
              <span class="step-number">01</span>
              <div class="step-content">
                <h3>The strategy & setup</h3>
                <p>We film with you once and set up your phone so shooting is easy.</p>
              </div>
            </div>

            <div class="step-item">
              <span class="step-number">02</span>
              <div class="step-content">
                <h3>Record on your time</h3>
                <p>You press record on your own time using the scripts we write for you.</p>
              </div>
            </div>

            <div class="step-item">
              <span class="step-number">03</span>
              <div class="step-content">
                <h3>We handle the rest</h3>
                <p>We do all the hard work—writing, editing, and posting every single video for you.</p>
              </div>
            </div>
          </div>

          <div class="video-column">
            <div class="video-wrapper">
              <video 
                autoplay 
                loop 
                muted 
                playsinline 
                preload="auto"
                style="width:100%; height:100%; object-fit:cover;"
              >
                <source src={`${base}/website-vid.mp4`} type="video/mp4" />
                Your browser does not support the video tag.
              </video>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Get Started / Contact -->
      <section id="contact" class="contact-section">
        <div class="container">
          <!-- Offer Banner -->
          <div class="offer-banner">
            <span class="offer-badge">Limited Availability</span>
            <h3 class="offer-title">Get Your Free Blueprint</h3>
            <p class="offer-text">
              To give every brand our full attention, we only work with 4 clients at a time. Fill out the form to get your free blueprint.
            </p>
          </div>

          <!-- Form Card -->
          <div class="form-card">
            <h2>Start Your Personal Brand</h2>
            <form 
              action="https://formsubmit.co/founderframemedia@gmail.com" 
              method="POST" 
              onsubmit="event.preventDefault(); fetch(this.action, { method: 'POST', body: new FormData(this) }).then(() => { alert('Thank you!'); this.reset(); });"
            >
              <div class="form-group">
                <label for="name">Your Name</label>
                <input type="text" id="name" name="name" placeholder="John Doe" required />
              </div>

              <div class="form-group">
                <label for="business">Business Name</label>
                <input type="text" id="business" name="business" placeholder="Business Inc." required />
              </div>

              <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" placeholder="john@example.com" required />
              </div>

              <div class="form-group">
                <label for="website">Website</label>
                <input type="url" id="website" name="website" placeholder="https://example.com" />
              </div>

              <button type="submit" class="submit-btn">Start Your Personal Brand</button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="#home" class="footer-logo"><Image src={mainLogo} alt="Founder Frame" /></a>
          <p class="footer-tagline">We plan, shoot, edit, and post all your content.</p>
          <a href="mailto:founderframemedia@gmail.com" class="footer-email">founderframemedia@gmail.com</a>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <p class="copyright">&copy; 2026 Founder Frame. All rights reserved.</p>
          <div class="footer-socials">
            <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
            <a href="https://www.tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.68 6.34 6.34 0 0 0 9.34 22a6.34 6.34 0 0 0 6.34-6.34V9.05a8.16 8.16 0 0 0 4.91 1.61V7.22a4.85 4.85 0 0 1-1-.53z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>