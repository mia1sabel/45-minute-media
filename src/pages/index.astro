---
import Layout from '../layout/layout.astro';
import mainLogo from '../assets/Rectangle Logo JPG.jpg';
import { Image } from 'astro:assets';

const navLinks = [
  { href: '#home', label: 'Home' },
  { href: '#work', label: 'Work' },
  { href: '#process', label: 'Process' },
  { href: '#contact', label: 'Get Started' },
];

const processSteps = [
  {
    step: '01',
    title: 'Brand Strategy & Blueprint',
    desc: 'We map out high-performing content pillars aligned with your business goals.',
    details: [
      'Visual Identity Guidelines',
      'Target Audience & Angle Mapping',
      'Content Pillar Development',
      'High-Impact Topic Ideas'
    ],
    badge: '1-2 Weeks Before Shoot',
    color: '#8B5CF6'
  },
  {
    step: '02',
    title: '45-Minute Studio Production',
    desc: 'Show up, lock in, and let us direct, light, and record your entire batch.',
    details: [
      'Full Studio & Lighting Setup',
      'Teleprompter & Live On-Set Directing',
      'High-Grade Audio Capture',
      'Seamless Batch Filming'
    ],
    badge: 'Shoot Day (45 Mins)',
    color: '#F59E0B'
  },
  {
    step: '03',
    title: 'Editing & Distribution',
    desc: 'We craft retention-focused edits, captions, and thumbnails ready to publish.',
    details: [
      'High-Engagement Captions & Subtitles',
      'Color Grading & Sound Design',
      'Custom Covers & Thumbnails',
      'Multi-Platform Scheduling'
    ],
    badge: 'Turnaround in 5 Days',
    color: '#10B981'
  }
];

const faqs = [
  {
    question: "How does 45 minutes of recording generate months of content?",
    answer: "Our proven scripting framework compresses high-value insights into efficient prompts. In 45 minutes, we record enough raw material to edit into 26 high-performing short-form videos."
  },
  {
    question: "Do I need prior on-camera experience?",
    answer: "Not at all. We direct you throughout the session, handle teleprompters, and guide your delivery so you sound natural, confident, and authoritative."
  },
  {
    question: "What is the turnaround time for finalized videos?",
    answer: "You receive your complete batch of fully edited, captioned, and formatted short-form videos within 5-7 business days of your shoot."
  },
  {
    question: "Which social media platforms are these videos formatted for?",
    answer: "We deliver videos optimized for Instagram Reels, TikTok, YouTube Shorts, and LinkedIn—complete with proper aspect ratios, captions, and hooks."
  },
  {
    question: "Can we shoot at our own location or office?",
    answer: "Yes, we offer on-site production for local teams as well as mobile studio setups, in addition to our dedicated studio space."
  }
];

const portfolioItems = [
  { title: "Standard Brand Content", category: "Social Reel", aspect: "aspect-vertical", videoSrc: "/promo.mp4" },
  { title: "Standard Event Content", category: "Promotional", aspect: "aspect-vertical", videoSrc: "/promo.mp4" },
  { title: "Story Driven", category: "Brand Story", aspect: "aspect-vertical", videoSrc: "/promo.mp4" }
];
---

<Layout title="45-Minute Media | Premium Short-Form Video Production">
  <div class="page-wrapper">
    
    <!-- HEADER -->
    <header class="main-header">
      <div class="header-container">
        <a href="#home" class="logo-link">
          <Image src={mainLogo} alt="45-Minute Media Logo" class="nav-logo" />
        </a>
        <nav class="nav-menu">
          {navLinks.map((link) => (
            <a href={link.href} class="nav-link">{link.label}</a>
          ))}
        </nav>
        <a href="#contact" class="btn-primary-sm">Get Started</a>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section id="home" class="hero-section">
      <div class="glow-backdrop"></div>
      <div class="hero-container">
        <div class="hero-badge-wrapper">
          <span class="hero-badge">⚡ 45 MINUTES TO 6 MONTHS OF CONTENT</span>
        </div>
        <h1 class="hero-title">
          6 Month’s worth of content for your business. <span class="gradient-text">Made simple.</span>
        </h1>
        <p class="hero-subtitle">
          Turn 45 minutes of filming into a continuous stream of premium, high-converting social media content designed to scale your brand authority.
        </p>
        <div class="hero-cta-wrapper">
          <a href="#contact" class="btn-primary">Book Your Shoot →</a>
          <a href="#work" class="secondary-btn">View Our Work</a>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-number">45m</span>
            <span class="stat-label">Filming Time</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">26+</span>
            <span class="stat-label">Edited Reels/Shorts</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <span class="stat-number">5-Day</span>
            <span class="stat-label">Turnaround</span>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES SECTION -->
    <section id="features" class="features-section">
      <div class="section-container">
        <div class="section-header center">
          <span class="section-tag">WHY WORK WITH US</span>
          <h2 class="section-title">Designed for Busy Founders & Teams</h2>
          <p class="section-desc">We eliminate the friction of content creation so you can focus on running your business.</p>
        </div>

        <div class="features-grid">
          <div class="feature-card">
            <h3>Streamlined Workflow</h3>
            <p>Zero scriptwriting needed on your end. We handle research, outline topics, and guide you live during recording.</p>
          </div>
          <div class="feature-card">
            <h3>Rapid Delivery</h3>
            <p>Get a complete batch of edited, formatted, and platform-ready videos delivered straight to your drive in days.</p>
          </div>
          <div class="feature-card">
            <h3>Scalable Engine</h3>
            <p>Maintain an active, professional presence across Instagram, TikTok, YouTube Shorts, and LinkedIn effortlessly.</p>
          </div>
          <div class="feature-card">
            <h3>Authority Building</h3>
            <p>Position yourself as an industry leader through crisp audio, professional lighting, and retention-focused editing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WORK SECTION -->
    <section id="work" class="work-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-tag">OUR WORK</span>
          <h2 class="section-title">Built to Grab Attention</h2>
          <p class="section-desc">Preview our editing style, framing, and sound design.</p>
        </div>

        <div class="portfolio-grid">
          {portfolioItems.map((item) => (
            <div class="work-card">
              <video src={item.videoSrc} controls playsinline class="work-video"></video>
              <div class="work-info">
                <span class="work-cat">{item.category}</span>
                <h4 class="work-title">{item.title}</h4>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS SECTION -->
    <section id="process" class="process-section">
      <div class="section-container">
        <div class="section-header center">
          <span class="section-tag">HOW IT WORKS</span>
          <h2 class="section-title">Three Steps to Months of Content</h2>
          <p class="section-desc">Our streamlined 3-phase production pipeline.</p>
        </div>

        <div class="process-grid">
          {processSteps.map((step) => (
            <div class="product-card">
              <div class="card-badge" style={`color: ${step.color}; background: ${step.color}15`}>{step.badge}</div>
              <span class="step-num">{step.step}</span>
              <h3>{step.title}</h3>
              <p>{step.desc}</p>
              <ul class="details-list">
                {step.details.map((d) => <li>✓ {d}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="faq-section">
      <div class="section-container narrow">
        <div class="section-header center">
          <span class="section-tag">QUESTIONS & ANSWERS</span>
          <h2 class="section-title">Frequently Asked Questions</h2>
        </div>

        <div class="faq-list">
          {faqs.map((faq) => (
            <div class="faq-item">
              <h4 class="faq-q">{faq.question}</h4>
              <p class="faq-a">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTACT SECTION -->
    <section id="contact" class="contact-section">
      <div class="section-container">
        <div class="contact-card">
          <div class="contact-info">
            <span class="section-tag">GET STARTED</span>
            <h2>Ready for 6 Month’s Worth of Content?</h2>
            <p>Fill out the form to schedule your 45-minute filming session or book a quick intro call with our team.</p>
            <div class="contact-highlights">
              <div class="highlight-item"><span class="check-icon">✓</span> Fast 5-Day Delivery</div>
              <div class="highlight-item"><span class="check-icon">✓</span> Full Scripting & Direction</div>
              <div class="highlight-item"><span class="check-icon">✓</span> Formatted for All Platforms</div>
            </div>
          </div>

          <form class="contact-form" action="https://formspree.io/f/mqaeednr" method="POST">
            <div class="form-group">
              <label>Full Name</label>
              <input type="text" name="name" placeholder="John Doe" required />
            </div>
            <div class="form-group">
              <label>Email Address</label>
              <input type="email" name="email" placeholder="john@company.com" required />
            </div>
            <div class="form-group">
              <label>Company / Brand</label>
              <input type="text" name="company" placeholder="Acme Inc." />
            </div>
            <div class="form-group">
              <label>Project Details</label>
              <textarea name="message" rows="4" placeholder="Tell us about your brand..." required></textarea>
            </div>
            <button type="submit" class="btn-primary full-width">Submit Request</button>
          </form>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="#home" class="footer-logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
          <p class="footer-tagline">6 Month’s worth of content for your business. Made simple.</p>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <p class="copyright">&copy; 2026 45-Minute Media. All rights reserved.</p>
          <div class="social-links">
            <a href="https://www.instagram.com/45minutemedia?igsh=MWttdHBvemJ3bDJybw==" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://www.tiktok.com/@45minute.media?_r=1&_t=ZP-98TqxC5woZT" target="_blank" rel="noopener noreferrer">TikTok</a>
          </div>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<style>
  .page-wrapper { background-color: #0A0A0B; color: #F3F4F6; min-height: 100vh; overflow-x: hidden; font-family: sans-serif; }
  .section-container { max-width: 1200px; margin: 0 auto; padding: 6rem 1.5rem; }
  .section-container.narrow { max-width: 800px; }
  .section-header { margin-bottom: 3.5rem; }
  .section-header.center { text-align: center; }
  .section-tag { display: inline-block; color: #F59E0B; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.75rem; }
  .section-title { font-size: 2.5rem; font-weight: 800; color: #FFFFFF; line-height: 1.2; margin-bottom: 1rem; }
  .section-desc { color: #9CA3AF; font-size: 1.125rem; max-width: 600px; }
  .section-header.center .section-desc { margin: 0 auto; }

  /* HEADER */
  .main-header { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: rgba(10, 10, 11, 0.8); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .header-container { max-width: 1200px; margin: 0 auto; padding: 1rem 1.5rem; display: flex; align-items: center; justify-content: space-between; }
  .nav-logo { height: 32px; width: auto; object-fit: contain; }
  .nav-menu { display: flex; gap: 2rem; }
  .nav-link { color: #9CA3AF; text-decoration: none; font-weight: 500; font-size: 0.95rem; transition: color 0.2s; }
  .nav-link:hover { color: #FFF; }
  .btn-primary-sm { background: #F59E0B; color: #000; padding: 0.5rem 1rem; border-radius: 6px; font-weight: 700; text-decoration: none; font-size: 0.85rem; }

  /* HERO */
  .hero-section { position: relative; padding: 10rem 1.5rem 6rem; text-align: center; }
  .glow-backdrop { position: absolute; top: 20%; left: 50%; transform: translate(-50%, -50%); width: 600px; height: 600px; background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, rgba(139, 92, 246, 0.1) 40%, transparent 70%); filter: blur(80px); pointer-events: none; }
  .hero-container { position: relative; z-index: 1; max-width: 900px; margin: 0 auto; }
  .hero-badge { background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); color: #F59E0B; padding: 0.5rem 1rem; border-radius: 9999px; font-size: 0.85rem; font-weight: 700; }
  .hero-title { font-size: 3.75rem; font-weight: 900; line-height: 1.1; margin: 1.5rem 0; color: #FFFFFF; }
  .gradient-text { background: linear-gradient(135deg, #F59E0B 0%, #FBBF24 50%, #8B5CF6 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-subtitle { font-size: 1.25rem; color: #9CA3AF; max-width: 700px; margin: 0 auto 2.5rem; line-height: 1.6; }
  .hero-cta-wrapper { display: flex; gap: 1rem; justify-content: center; margin-bottom: 4rem; }
  .btn-primary { background: #F59E0B; color: #000; padding: 0.875rem 1.75rem; border-radius: 8px; font-weight: 700; text-decoration: none; border: none; cursor: pointer; }
  .secondary-btn { padding: 0.875rem 1.75rem; border-radius: 8px; font-weight: 600; color: #F3F4F6; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); text-decoration: none; }
  .hero-stats { display: inline-flex; align-items: center; background: rgba(18, 18, 20, 0.8); border: 1px solid rgba(255, 255, 255, 0.08); padding: 1.25rem 2.5rem; border-radius: 16px; }
  .stat-item { display: flex; flex-direction: column; align-items: center; }
  .stat-number { font-size: 1.75rem; font-weight: 800; color: #FFFFFF; }
  .stat-label { font-size: 0.85rem; color: #6B7280; margin-top: 0.25rem; }
  .stat-divider { width: 1px; height: 35px; background: rgba(255, 255, 255, 0.1); margin: 0 2rem; }

  /* FEATURES */
  .features-section { background: #0E0E10; border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
  .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; }
  .feature-card { background: rgba(18, 18, 20, 0.6); border: 1px solid rgba(255, 255, 255, 0.06); padding: 2rem; border-radius: 12px; }
  .feature-card h3 { font-size: 1.25rem; font-weight: 700; color: #FFF; margin-bottom: 0.75rem; }
  .feature-card p { color: #9CA3AF; font-size: 0.95rem; line-height: 1.5; }

  /* WORK */
  .portfolio-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
  .work-card { background: #121214; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; overflow: hidden; }
  .work-video { width: 100%; height: 300px; object-fit: cover; background: #000; }
  .work-info { padding: 1.25rem; }
  .work-cat { color: #F59E0B; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
  .work-title { font-size: 1.1rem; color: #FFF; margin-top: 0.25rem; }

  /* PROCESS */
  .process-section { background: #0E0E10; }
  .process-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .product-card { background: #121214; border: 1px solid rgba(255, 255, 255, 0.08); padding: 2rem; border-radius: 16px; position: relative; }
  .card-badge { display: inline-block; padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; margin-bottom: 1rem; }
  .step-num { position: absolute; top: 1.5rem; right: 1.5rem; font-size: 2rem; font-weight: 900; opacity: 0.2; color: #FFF; }
  .product-card h3 { color: #FFF; margin-bottom: 0.5rem; }
  .product-card p { color: #9CA3AF; font-size: 0.9rem; margin-bottom: 1.5rem; }
  .details-list { list-style: none; padding: 0; color: #D1D5DB; font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.5rem; }

  /* FAQ */
  .faq-list { display: flex; flex-direction: column; gap: 1rem; }
  .faq-item { background: #121214; border: 1px solid rgba(255, 255, 255, 0.06); padding: 1.5rem; border-radius: 12px; }
  .faq-q { color: #FFF; font-size: 1.1rem; margin-bottom: 0.5rem; }
  .faq-a { color: #9CA3AF; font-size: 0.95rem; line-height: 1.5; }

  /* CONTACT */
  .contact-card { background: #121214; border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; padding: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .contact-info h2 { font-size: 2rem; color: #FFF; margin: 0.5rem 0 1rem; }
  .contact-info p { color: #9CA3AF; margin-bottom: 2rem; }
  .contact-highlights { display: flex; flex-direction: column; gap: 0.75rem; color: #E5E7EB; }
  .check-icon { color: #F59E0B; font-weight: 800; }
  .contact-form { display: flex; flex-direction: column; gap: 1rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.85rem; color: #D1D5DB; font-weight: 600; }
  .form-group input, .form-group textarea { background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); padding: 0.75rem; border-radius: 8px; color: #FFF; }
  .full-width { width: 100%; margin-top: 0.5rem; }

  /* FOOTER */
  footer { border-top: 1px solid rgba(255, 255, 255, 0.08); background: #070708; padding: 3rem 1.5rem 2rem; }
  .footer-inner { max-width: 1200px; margin: 0 auto; text-align: center; }
  .footer-logo img { height: 32px; width: auto; }
  .footer-tagline { color: #9CA3AF; margin-top: 0.5rem; font-size: 0.9rem; }
  .footer-divider { height: 1px; background: rgba(255, 255, 255, 0.06); margin: 2rem 0; }
  .footer-bottom { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: #6B7280; }
  .social-links { display: flex; gap: 1rem; }
  .social-links a { color: #9CA3AF; text-decoration: none; }

  @media (max-width: 768px) {
    .contact-card { grid-template-columns: 1fr; padding: 1.5rem; }
    .hero-title { font-size: 2.5rem; }
    .hero-cta-wrapper { flex-direction: column; }
    .hero-stats { flex-direction: column; gap: 1rem; }
    .stat-divider { width: 60%; height: 1px; margin: 0; }
    .nav-menu { display: none; }
  }
</style>