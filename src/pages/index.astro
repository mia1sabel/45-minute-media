---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>45-Minute Media | Video Production</title>
    <style>
      :root {
        --bg-color: #FAFAFA;
        --text-main: #111827;
        --text-muted: #6B7280;
        --accent: #2563EB;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }
      
      /* Header & Nav */
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.5rem 5%; max-width: 1200px; margin: 0 auto; width: 100%;
      }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 48px; width: auto; max-height: 48px; object-fit: contain; }
      nav { display: flex; gap: 2rem; align-items: center; }
      nav a {
        text-decoration: none; color: var(--text-muted); font-weight: 500;
        font-size: 0.95rem; transition: color 0.2s ease;
      }
      nav a:hover, nav a.active { color: var(--text-main); }

      /* Hero Section */
      .hero {
        padding: 5rem 5% 4rem; text-align: center;
        display: flex; flex-direction: column; align-items: center;
      }
      .hero-content { max-width: 750px; }
      h1 {
        font-size: clamp(1.85rem, 3.5vw, 2.75rem);
        font-weight: 700; line-height: 1.2;
        letter-spacing: -0.025em; margin-bottom: 1rem; color: #000;
      }
      p.subtitle {
        font-size: clamp(0.95rem, 1.4vw, 1.1rem);
        color: var(--text-muted); margin-bottom: 1.75rem;
        line-height: 1.5; max-width: 600px; margin-inline: auto;
      }
      
      .cta-btn {
        display: inline-block; background-color: #0F172A; color: #FFF;
        padding: 0.6rem 1.25rem; border-radius: 6px; text-decoration: none;
        font-weight: 500; font-size: 0.85rem;
        transition: background-color 0.2s ease;
      }
      .cta-btn:hover { background-color: #1E293B; }

      /* How It Works Section */
      .how-it-works {
        width: 100%; max-width: 900px; margin: 3rem auto 6rem;
        padding: 0 5%; text-align: left;
      }
      .section-tag {
        font-size: 0.75rem; font-weight: 700; color: var(--accent);
        letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.5rem;
      }
      .section-title {
        font-size: 1.85rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 3rem;
      }
      
      .step-item {
        display: flex; gap: 3rem; align-items: flex-start;
        padding-top: 2rem; padding-bottom: 2rem;
        border-top: 1px solid #E5E7EB;
      }
      .step-number {
        font-size: 1.15rem; font-weight: 700; color: var(--accent);
        min-width: 2.5rem;
      }
      .step-content h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.35rem; color: #111827; }
      .step-content p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }

      /* Footer Matching Reference */
      footer {
        background-color: #050505; color: #9CA3AF; padding: 4rem 5% 3rem;
        width: 100%; margin-top: auto;
      }
      .footer-inner {
        max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;
      }
      .footer-brand .footer-logo img { height: 32px; filter: brightness(0) invert(1); margin-bottom: 1rem; }
      .footer-tagline { font-size: 0.9rem; color: #9CA3AF; }
      
      .footer-divider { height: 1px; background-color: #1F2937; width: 100%; }
      
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.85rem;
      }
      .footer-nav { display: flex; gap: 1.75rem; }
      .footer-nav a { color: #D1D5DB; text-decoration: none; transition: color 0.2s; }
      .footer-nav a:hover { color: #FFF; }
      .copyright { color: #6B7280; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href="/" class="active">Home</a>
        <a href="/work">Work</a>
        <a href="/contact">Get Started</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <h1>Your Entire Month of Social Media Videos.<br />Only 45 Minutes of Your Time.</h1>
          <p class="subtitle">
            Video production for brands who'd rather be running their business.
          </p>
          <a href="/contact" class="cta-btn">Start a Project</a>
        </div>
      </section>

      <section class="how-it-works">
        <p class="section-tag">HOW IT WORKS</p>
        <h2 class="section-title">Three steps, start to finish.</h2>
        
        <div class="steps-container">
          <div class="step-item">
            <span class="step-number">01</span>
            <div class="step-content">
              <h3>One short call</h3>
              <p>We talk through your business and what you need for the month.</p>
            </div>
          </div>

          <div class="step-item">
            <span class="step-number">02</span>
            <div class="step-content">
              <h3>You approve the plan</h3>
              <p>A simple plan for the month. You approve it once.</p>
            </div>
          </div>

          <div class="step-item">
            <span class="step-number">03</span>
            <div class="step-content">
              <h3>We handle the rest</h3>
              <p>Filming, editing, delivery. Nothing else needed until next month.</p>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
          <p class="footer-tagline">Video content for social media, made simple.</p>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <div class="footer-nav">
            <a href="/">Home</a>
            <a href="/work">Work</a>
            <a href="/contact">Get Started</a>
          </div>
          <p class="copyright">&copy; 2026 45-Minute Media. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>