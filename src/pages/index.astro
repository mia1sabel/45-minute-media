---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
import faviconImg from '../assets/Circle Logo SVG transparent.svg';

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>45-Minute Media</title>
    <style>
      :root {
        --bg-color: #FAFAFA;
        --text-main: #111827;
        --text-muted: #6B7280;
        --accent: #2563EB;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }

      /* Header Styling */
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 5%; width: 100%; max-width: 1400px; margin: 0 auto;
        border-bottom: 1px solid #E5E7EB;
      }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 90px; width: auto; object-fit: contain; }

      nav { display: flex; gap: 1.25rem; align-items: center; }
      nav a {
        text-decoration: none; color: var(--text-muted); font-weight: 600;
        font-size: 0.95rem; transition: color 0.2s ease; white-space: nowrap;
      }
      nav a:hover, nav a.active { color: var(--text-main); }

      /* Mobile Header Fix */
      @media (max-width: 640px) {
        header { flex-direction: column; gap: 1rem; padding: 1rem 5%; }
        .logo img { height: 65px; }
        nav { gap: 1.5rem; }
      }

      /* Hero Section */
      main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 5%; text-align: center; }
      .hero { max-width: 800px; margin: 0 auto; }
      h1 { font-size: 3rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1.15; margin-bottom: 1.25rem; }
      p.subtitle { font-size: 1.25rem; color: var(--text-muted); margin-bottom: 2rem; line-height: 1.5; }
      .cta-btn {
        display: inline-block; background-color: #0F172A; color: #FFF;
        padding: 1rem 2rem; border-radius: 8px; font-weight: 600;
        text-decoration: none; transition: background-color 0.2s ease, transform 0.1s ease;
      }
      .cta-btn:hover { background-color: #1E293B; transform: translateY(-1px); }

      /* Footer */
      footer {
        background-color: #050505; color: #9CA3AF; padding: 4rem 5% 3rem;
        width: 100%; margin-top: auto;
      }
      .footer-inner {
        max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;
      }
      .footer-brand .footer-logo img { height: 110px; width: auto; display: block; margin-bottom: 1rem; }
      .footer-tagline { font-size: 1rem; color: #9CA3AF; }
      .footer-divider { height: 1px; background-color: #1F2937; width: 100%; }
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.95rem;
      }
      .footer-nav { display: flex; gap: 2rem; }
      .footer-nav a { color: #D1D5DB; text-decoration: none; font-weight: 500; transition: color 0.2s; }
      .footer-nav a:hover { color: #FFF; }
      .copyright { color: #6B7280; }
    </style>
  </head>
  <body>
    <header>
      <a href={`${base}/`} class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href={`${base}/`} class="active">Home</a>
        <a href={`${base}/work`}>Work</a>
        <a href={`${base}/contact`}>Get Started</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <h1>High-converting short-form video for modern brands.</h1>
        <p class="subtitle">We create scroll-stopping Instagram Reels, TikToks, and Shorts that grow your business.</p>
        <a href={`${base}/contact`} class="cta-btn">Get Started</a>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${base}/`} class="footer-logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
          <p class="footer-tagline">Video content for social media, made simple.</p>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <div class="footer-nav">
            <a href={`${base}/`}>Home</a>
            <a href={`${base}/work`}>Work</a>
            <a href={`${base}/contact`}>Get Started</a>
          </div>
          <p class="copyright">&copy; 2026 45-Minute Media. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>