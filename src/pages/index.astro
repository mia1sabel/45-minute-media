---
import { Image } from 'astro:assets';
import mainLogo from '../assets/1.png';
import faviconImg from '../assets/7.svg';
import ogImage from '../assets/Founder Frame Logo.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const intrestformUrl = `${base}/intrestform`; 
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GZSMYG4C65"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-GZSMYG4C65');
    </script>

    <title>Founder Frame | Get More Clients By Just Being You</title>

    <link rel="canonical" href="https://fnderframe.com" />
    <meta property="og:url" content="https://fnderframe.com" />
    <meta property="og:title" content="Founder Frame" />
    <meta property="og:description" content="For Atlanta businesses that know having an audience, is the marketing." />
    <meta property="og:image" content={`https://fnderframe.com${ogImage.src}`} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />

    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap" rel="stylesheet">

    <style>
      :root {
        --bg-color: #F8F3E9;
        --text-main: #000000;
        --text-muted: #555555;
        --grid-line-light: rgba(0, 0, 0, 0.15);
      }

      html { scroll-behavior: smooth; }
      
      /* Sharp edges site-wide */
      * { box-sizing: border-box; margin: 0; padding: 0; border-radius: 0 !important; box-shadow: none !important; }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }

      header {
        position: relative;
        background-color: transparent;
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 3rem; width: 100%;
        border-bottom: 2px solid var(--grid-line-light);
      }
      .logo { display: flex; align-items: center; text-decoration: none; margin-left: 0; }
      .logo img { height: 75px; width: auto; object-fit: contain; display: block; }

      nav { display: flex; gap: 2rem; align-items: center; font-family: 'Inter', sans-serif; }
      nav a {
        text-decoration: none; color: #555555; font-weight: 500;
        font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; transition: all 0.25s ease;
        padding: 0.5rem 1rem;
      }
      nav a:hover { color: var(--text-main); }
      nav a:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.6);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.15) !important;
      }

      /* FADE-IN & SLIDE UP ANIMATION CLASSES (BIDIRECTIONAL) */
      .fade-slide-in {
        opacity: 0;
        transform: translateY(8px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
      }
      .fade-slide-in.visible {
        opacity: 1;
        transform: translateY(0);
      }

      /* HERO SECTION (WARM CREAM, SINGLE LINE) */
      .hero {
        padding: 6.5rem 5% 6rem; text-align: center;
        display: flex; flex-direction: column; align-items: center;
        position: relative;
        border-bottom: 2px solid var(--grid-line-light);
      }

      .hero-content { max-width: 1200px; width: 100%; margin: 0 auto; }
      
      h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3.2vw, 3.5rem);
        font-weight: 500; line-height: 1.15;
        letter-spacing: -0.01em; margin-bottom: 1.5rem; color: var(--text-main);
        text-align: center; width: 100%;
      }
      h1 em {
        font-family: 'Playfair Display', serif;
        font-style: italic;
        font-weight: 400;
      }

      p.subtitle {
        font-size: clamp(1rem, 1.6vw, 1.25rem);
        color: #555555; margin-bottom: 2.5rem;
        line-height: 1.6; max-width: none; margin-inline: auto; font-weight: 300;
      }
      
      /* CTA BUTTONS MATCHED TO ONBOARDING QUESTIONNAIRE */
      .cta-btn {
        display: inline-flex; align-items: center; justify-content: center;
        background-color: var(--text-main); color: var(--bg-color);
        border: none;
        padding: 1.25rem 3.25rem; text-decoration: none;
        font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.12em;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      }
      .cta-btn:hover {
        background-color: #1A1A1A; color: #FFFFFF;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.25) !important;
      }
      .cta-btn:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.6);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.15) !important;
      }

      /* SHARED SECTION INNER WRAPPER FOR CENTERING & PADDING */
      .section-inner {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
      }

      /* ABOUT OUR AGENCY SECTION (WIDER SPREAD, CLOSER TO EDGES) */
      .about-agency-section {
        background-color: #000000;
        color: #F8F3E9;
        padding: 6rem 2.5rem;
        width: 100%;
        border-bottom: 2px solid rgba(255, 255, 255, 0.15);
      }

      .about-agency-grid {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 5rem;
        align-items: center;
      }
      @media (min-width: 1024px) {
        .about-agency-grid {
          grid-template-columns: 1fr 1.35fr;
        }
      }

      .about-agency-left {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        gap: 1rem;
        padding-left: 1rem;
      }

      .about-agency-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.75rem, 2.5vw, 2.3rem);
        font-weight: 500;
        color: #F8F3E9;
        line-height: 1.2;
      }
      .about-agency-title em {
        font-style: italic;
        font-weight: 400;
      }

      .about-agency-desc {
        font-size: clamp(0.95rem, 1.2vw, 1.05rem);
        color: #E5E2D9;
        font-weight: 300;
        line-height: 1.6;
      }

      /* 3-COLUMN TICKER ROW (PULLED CLOSER TO THE RIGHT EDGE) */
      .about-ticker-right {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px !important;
        padding: 2.25rem 2.5rem;
        margin-right: 1rem;
      }
      @media (min-width: 768px) {
        .about-ticker-right {
          grid-template-columns: repeat(3, 1fr);
          gap: 1.75rem;
        }
      }

      .ticker-item {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .ticker-number {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 2.3vw, 2.5rem);
        font-weight: 500;
        color: #F8F3E9;
        line-height: 1;
      }

      .ticker-text {
        font-size: 0.85rem;
        color: #AAAAAA;
        font-weight: 300;
        line-height: 1.4;
      }

      /* WARM CREAM MIDDLE SECTION */
      .middle-cream-section {
        background-color: var(--bg-color);
        color: #000000;
        padding: 8rem 3rem;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 8rem;
        border-bottom: 2px solid var(--grid-line-light);
        position: relative;
      }

      .how-it-works-grid {
        display: grid; grid-template-columns: 1fr; gap: 4rem; align-items: center;
        width: 100%;
      }
      @media (min-width: 900px) {
        .how-it-works-grid { grid-template-columns: 1.2fr 0.8fr; }
      }

      /* HOW IT WORKS CONTAINER WITH BLACK BORDER & BLACK TEXT */
      .steps-container {
        display: flex; flex-direction: column; width: 100%;
        background: transparent;
        color: #000000;
        padding: 3.5rem 3rem;
        border: 2px solid #000000;
      }

      .section-tag {
        font-size: 0.85rem; font-weight: 600; color: #000000;
        letter-spacing: 0.18em; text-transform: uppercase; margin-bottom: 1.5rem;
      }
      
      .step-item {
        display: flex; gap: 2rem; align-items: flex-start;
        padding-top: 1.5rem; padding-bottom: 1.5rem;
        border-top: 1px solid rgba(0, 0, 0, 0.15); width: 100%;
      }
      .step-item:last-child { border-bottom: 1px solid rgba(0, 0, 0, 0.15); }
      
      .step-number {
        font-size: 1.25rem; font-weight: 600; color: #000000; min-width: 2rem;
      }
      
      .step-content h3 {
        font-family: 'Playfair Display', serif; font-size: 1.5rem; font-weight: 500;
        color: #000000; margin-bottom: 0.4rem;
      }
      
      .step-content p {
        color: #444444; font-size: 1.02rem; line-height: 1.5; font-weight: 300;
      }

      /* 3D TILT EFFECT CONTAINERS */
      .iphone-wrapper {
        position: relative; display: flex; justify-content: center; align-items: center; width: 100%;
        perspective: 1000px;
      }

      .iphone-frame {
        position: relative; width: 100%; max-width: 290px; aspect-ratio: 9 / 19.5;
        background: #000000;
        border: 8px solid #1c1c1e;
        border-radius: 40px !important;
        overflow: hidden; display: flex; flex-direction: column;
        z-index: 1;
        transform-style: preserve-3d;
        will-change: transform;
        transition: transform 0.1s ease-out;
      }

      .iphone-notch {
        position: absolute; top: 10px; left: 50%; transform: translateX(-50%);
        width: 75px; height: 18px; background-color: #1c1c1e;
        border-radius: 16px !important;
        z-index: 10;
      }

      .iphone-screen {
        position: relative; width: 100%; height: 100%; overflow: hidden; background: #000;
      }
      .iphone-screen video { width: 100%; height: 100%; object-fit: cover; display: block; }

      .iphone-ui-hint {
        position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
        width: 85%; display: flex; flex-direction: column; gap: 8px; z-index: 5; pointer-events: none;
      }
      .progress-bar-container {
        width: 100%; height: 3px; background: rgba(255, 255, 255, 0.3); overflow: hidden;
      }
      .progress-bar-active {
        width: 45%; height: 100%; background: #FFFFFF;
      }
      .ui-play-icon {
        width: 14px; height: 14px; fill: #FFFFFF; opacity: 0.8; align-self: flex-start;
      }

      /* VIDEO SHOWCASE GRID */
      .video-showcase-section {
        width: 100%;
        text-align: center;
        padding: 0 1.5rem;
      }

      .showcase-main-title {
        font-family: 'Playfair Display', serif;
        font-weight: 400;
        font-size: clamp(1.2rem, 2.3vw, 3.1rem); 
        line-height: 1.25;
        letter-spacing: -0.01em;
        color: #000000;
        margin-bottom: 1rem;
        text-align: center;
        width: 100%;
      }
      .showcase-main-title em {
        font-style: italic;
        font-weight: 400;
      }

      .showcase-main-desc {
        font-size: clamp(1.1rem, 1.8vw, 1.3rem); color: #444444; font-weight: 400; margin-bottom: 3.5rem;
        text-align: center;
      }

      .video-showcase-grid {
        display: grid; grid-template-columns: 1fr; gap: 2.5rem; justify-items: center; width: 100%;
      }
      @media (min-width: 768px) {
        .video-showcase-grid { grid-template-columns: repeat(3, 1fr); }
      }

      .video-showcase-card {
        display: flex; flex-direction: column; align-items: center; gap: 1.25rem; width: 100%;
      }

      /* WARM CREAM CTA SECTION WITH THICK BLACK FRAME */
      .cream-cta-section {
        background-color: var(--bg-color);
        padding: 8rem 3rem;
        width: 100%;
        display: flex; justify-content: center; align-items: center;
      }

      .offer-banner {
        background: transparent;
        color: var(--text-main);
        text-align: center;
        display: flex; flex-direction: column; align-items: center; gap: 1.75rem;
        width: 100%;
        max-width: 1000px;
        padding: 4.5rem 3.5rem;
        border: 3px solid #000000;
      }
      .offer-title {
        font-family: 'Playfair Display', serif; 
        font-size: clamp(2.5rem, 4vw, 3.5rem); 
        font-weight: 500; 
        color: var(--text-main);
        line-height: 1.15;
      }
      
      .offer-text-container {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        align-items: center;
        width: 100%;
      }
      
      .offer-line { 
        font-size: 1.05rem; 
        color: #444444; 
        line-height: 1.4; 
        font-weight: 300; 
      }
      .offer-line strong { color: var(--text-main); font-weight: 600; }

      .banner-cta-btn {
        display: inline-flex; align-items: center; justify-content: center;
        background-color: var(--text-main); color: var(--bg-color);
        border: none;
        padding: 1.25rem 3.25rem; text-decoration: none;
        font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.12em;
        cursor: pointer;
        transition: all 0.25s ease;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
      }
      .banner-cta-btn:hover {
        background-color: #1A1A1A; color: #FFFFFF;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.25) !important;
      }
      .banner-cta-btn:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.6);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.15) !important;
      }

      footer {
        background-color: #0A0A0A; color: #888888; padding: 4rem 3rem 3rem;
        width: 100%; border-top: 2px solid rgba(255, 255, 255, 0.15);
      }
      .footer-inner { max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem; }
      .footer-brand .footer-logo img { height: 75px; width: auto; display: block; margin-bottom: 1.25rem; filter: invert(1); }
      .footer-tagline { font-size: 1rem; color: #AAAAAA; margin-bottom: 0.5rem; font-weight: 300; margin-left: 1.5rem; }
      .footer-email { font-size: 1rem; color: #FFFFFF; text-decoration: none; font-weight: 400; transition: color 0.2s; margin-left: 1.5rem; }
      .footer-email:hover { color: #CCCCCC; }
      .footer-divider { height: 1px; background-color: #222222; width: 100%; }
      .footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; font-size: 0.9rem; }
      .footer-socials { display: flex; gap: 1.25rem; align-items: center; }
      .footer-socials a { color: #AAAAAA; transition: color 0.25s ease; padding: 0.2rem; }
      .footer-socials a:hover {
        color: #FFFFFF;
      }
      .footer-socials a:focus {
        outline: none;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.15) !important;
      }
      .footer-socials svg { width: 20px; height: 20px; fill: currentColor; display: block; }
      .copyright { color: #777777; margin-left: 1.5rem; }

      @media (max-width: 640px) {
        header { flex-direction: column; gap: 1rem; padding: 1.25rem 5%; }
        .logo img { height: 60px; }
        .footer-tagline, .footer-email, .copyright { margin-left: 0; }
        .hero { padding: 4rem 5% 3.5rem; }
        .about-agency-section { padding: 4rem 1.5rem; }
        .middle-cream-section { padding: 4.5rem 1.5rem; gap: 5rem; }
        .cream-cta-section { padding: 5rem 1.5rem; }
        .offer-banner { padding: 3rem 1.5rem; }
        .steps-container { padding: 3rem 1.75rem; }
        .showcase-main-title {
          font-size: clamp(0.72rem, 3.2vw, 1.1rem);
          white-space: nowrap;
          overflow: hidden;
          text-overflow: clip;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="#home" class="logo"><Image src={mainLogo} alt="Founder Frame" /></a>
      <nav>
        <a href={intrestformUrl} target="_blank" rel="noopener noreferrer">Get Started</a>
      </nav>
    </header>

    <main>
      <!-- HERO SECTION -->
      <section id="home" class="hero fade-slide-in">
        <div class="hero-content">
          <h1>Get More Clients By Just <em>Being You.</em></h1>
          <p class="subtitle">For Atlanta businesses that know having an audience, is the marketing.</p>
          <a href={intrestformUrl} target="_blank" rel="noopener noreferrer" class="cta-btn">See If You Qualify &rarr;</a>
        </div>
      </section>

      <!-- ABOUT OUR AGENCY SECTION -->
      <section class="about-agency-section fade-slide-in">
        <div class="about-agency-grid">
          <div class="about-agency-left">
            <h2 class="about-agency-title">About Our <em>Agency</em></h2>
            <p class="about-agency-desc">
              Founder Frame is an Atlanta-based personal branding agency.<br />
              We help business owners turn their personal brand into an automated lead pipeline.
            </p>
          </div>
          <div class="about-ticker-right">
            <div class="ticker-item">
              <span class="ticker-number">04</span>
              <p class="ticker-text">Max active clients at a time</p>
            </div>
            <div class="ticker-item">
              <span class="ticker-number">1-Day</span>
              <p class="ticker-text">On-site iPhone shoot in Atlanta</p>
            </div>
            <div class="ticker-item">
              <span class="ticker-number">100%</span>
              <p class="ticker-text">Done-for-you scripting & editing</p>
            </div>
          </div>
        </div>
      </section>

      <!-- WARM CREAM MIDDLE SECTION -->
      <div class="middle-cream-section">
        <!-- HOW IT WORKS -->
        <section class="how-it-works-grid section-inner fade-slide-in">
          <div class="steps-container">
            <p class="section-tag">HOW IT WORKS</p>
            <div class="step-item">
              <span class="step-number">01</span>
              <div class="step-content">
                <h3>We film with you once</h3>
                <p>And set up your phone so shooting is easy.</p>
              </div>
            </div>
            <div class="step-item">
              <span class="step-number">02</span>
              <div class="step-content">
                <h3>You press record</h3>
                <p>On your own time using the scripts we write for you.</p>
              </div>
            </div>
            <div class="step-item">
              <span class="step-number">03</span>
              <div class="step-content">
                <h3>We do all the hard work</h3>
                <p>Writing, editing, and posting every single video for you.</p>
              </div>
            </div>
          </div>

          <div class="iphone-wrapper">
            <div class="iphone-frame tilt-card">
              <div class="iphone-notch"></div>
              <div class="iphone-screen">
                <video autoplay loop muted playsinline preload="auto">
                  <source src={`${base}/does-it-matter.mp4`} type="video/mp4" />
                </video>
                <div class="iphone-ui-hint">
                  <svg class="ui-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  <div class="progress-bar-container"><div class="progress-bar-active"></div></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- 3 VIDEO SHOWCASE -->
        <section class="video-showcase-section fade-slide-in">
          <h2 class="showcase-main-title">Premium <em>scripting</em>. &nbsp; Premium <em>editing</em>. &nbsp; Premium <em>results</em>.</h2>
          <p class="showcase-main-desc">We plan, edit, and post all your content.</p>

          <div class="video-showcase-grid section-inner">
            <div class="video-showcase-card">
              <div class="iphone-wrapper">
                <div class="iphone-frame tilt-card">
                  <div class="iphone-notch"></div>
                  <div class="iphone-screen">
                    <video autoplay loop muted playsinline preload="auto">
                      <source src={`${base}/dj-marc-blends.mp4`} type="video/mp4" />
                    </video>
                    <div class="iphone-ui-hint">
                      <svg class="ui-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      <div class="progress-bar-container"><div class="progress-bar-active"></div></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="video-showcase-card">
              <div class="iphone-wrapper">
                <div class="iphone-frame tilt-card">
                  <div class="iphone-notch"></div>
                  <div class="iphone-screen">
                    <video autoplay loop muted playsinline preload="auto">
                      <source src={`${base}/reintroduction.mp4`} type="video/mp4" />
                    </video>
                    <div class="iphone-ui-hint">
                      <svg class="ui-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      <div class="progress-bar-container"><div class="progress-bar-active"></div></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="video-showcase-card">
              <div class="iphone-wrapper">
                <div class="iphone-frame tilt-card">
                  <div class="iphone-notch"></div>
                  <div class="iphone-screen">
                    <video autoplay loop muted playsinline preload="auto">
                      <source src={`${base}/wrens-nest-post-4.mp4`} type="video/mp4" />
                    </video>
                    <div class="iphone-ui-hint">
                      <svg class="ui-play-icon" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                      <div class="progress-bar-container"><div class="progress-bar-active"></div></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- WARM CREAM CTA SECTION -->
      <section id="contact" class="cream-cta-section fade-slide-in">
        <div class="container" style="display: flex; justify-content: center; width: 100%;">
          <div class="offer-banner">
            <h3 class="offer-title">Get Your <em>Free</em> Blueprint</h3>
            <a href={intrestformUrl} target="_blank" rel="noopener noreferrer" class="banner-cta-btn">Start Your Personal Brand &rarr;</a>
            <div class="offer-text-container">
