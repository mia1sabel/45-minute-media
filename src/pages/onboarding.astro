---
import { Image } from 'astro:assets';
import mainLogo from '../assets/1.png';
import faviconImg from '../assets/7.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const thankYouUrl = `${base}/thank-you`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Client Onboarding Questionnaire | Founder Frame</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<script async src="https://www.googletagmanager.com/gtm.js?id=GTM-KV7T3MVG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
</script>
    <style>
      :root {
        --bg-color: #F8F3E9;
        --surface-color: #0F0F0F;
        --text-main: #000000;
        --text-light: #FFFFFF;
        --text-muted: #AAAAAA;
        --accent-gray: #CCCCCC;
        --border-dark: rgba(255, 255, 255, 0.08);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; border-radius: 0 !important; }
      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }

      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 2.5rem; width: 100%;
        border-bottom: 1.5px solid #E5E2D9;
        background-color: var(--bg-color);
      }
      .logo { display: flex; align-items: center; text-decoration: none; margin-left: 0; }
      .logo img { height: 75px; width: auto; object-fit: contain; display: block; }

      .container {
        max-width: 760px; width: 100%; margin: 4rem auto; padding: 0 1.5rem;
      }

      .form-card {
        background: linear-gradient(145deg, rgba(20, 20, 20, 0.96), rgba(10, 10, 10, 0.99));
        backdrop-filter: blur(12px);
        color: var(--text-light);
        padding: 3.5rem;
        border: 1px solid var(--border-dark);
        /* Rich, layered multi-stage shadow for realistic physical depth */
        box-shadow: 
          0 10px 30px -5px rgba(0, 0, 0, 0.15),
          0 20px 50px -10px rgba(0, 0, 0, 0.25),
          0 30px 90px 0px rgba(0, 0, 0, 0.3), 
          inset 0 1px 1px rgba(255,255,255,0.1) !important;
      }

      .progress-header { margin-bottom: 2.5rem; }

      .progress-bar-bg {
        width: 100%; height: 4px; background-color: rgba(255, 255, 255, 0.08); overflow: hidden;
      }

      .progress-bar-fill {
        height: 100%; width: 20%; background-color: var(--accent-gray);
        transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      }

      h1 {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3vw, 2.6rem); font-weight: 500; margin-bottom: 0.75rem;
        letter-spacing: -0.01em; color: var(--text-light); text-align: center; line-height: 1.2;
      }

      .form-subtitle {
        color: var(--text-muted); text-align: center; font-weight: 300; margin-bottom: 3rem; font-size: 1.05rem;
      }

      .section-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem; font-weight: 500; margin-bottom: 1.75rem;
        padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-dark); color: var(--accent-gray);
      }

      .form-step { display: none; }
      .form-step.active { display: block; }

      .form-group { display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.75rem; text-align: left; }
      .form-group label {
        font-size: 0.8rem; font-weight: 600; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.08em;
      }
      
      /* Custom dark input surface & fine border */
      .form-group input, .form-group textarea {
        padding: 1.1rem 1.25rem; border: 1px solid rgba(255, 255, 255, 0.12);
        font-size: 1rem; font-family: 'Inter', sans-serif; transition: all 0.25s ease;
        outline: none; background-color: rgba(255, 255, 255, 0.04); color: var(--text-light);
      }
      .form-group textarea { resize: vertical; min-height: 110px; }
      
      /* Soft interactive focus glow for inputs and buttons */
      .form-group input:focus, .form-group textarea:focus,
      .btn-next:focus, .btn-submit:focus, .btn-back:focus { 
        border-color: rgba(255, 255, 255, 0.6); 
        background-color: rgba(255, 255, 255, 0.06);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.15) !important;
      }

      .nav-buttons {
        display: flex; justify-content: space-between; align-items: center; margin-top: 3rem; gap: 1rem;
      }

      .btn-back {
        background: transparent; color: var(--text-muted); border: none;
        font-family: 'Inter', sans-serif; font-size: 0.95rem; font-weight: 500;
        cursor: pointer; padding: 0.75rem 1rem; transition: all 0.25s ease;
      }
      .btn-back:hover { color: var(--text-light); }

      .btn-next {
        background-color: var(--bg-color); color: var(--text-main); border: none;
        padding: 1rem 2.5rem; font-family: 'Inter', sans-serif;
        font-weight: 700; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em;
        cursor: pointer; transition: all 0.25s ease; margin-left: auto;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
      }
      .btn-next:hover { 
        background-color: #E5E5E5; color: #000; transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.25) !important;
      }

      .btn-submit {
        background-color: var(--bg-color); color: var(--text-main); border: none;
        padding: 1.2rem 3rem; font-family: 'Inter', sans-serif;
        font-weight: 700; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.12em;
        cursor: pointer; transition: all 0.25s ease; width: 100%; 
        box-shadow: 0 8px 30px rgba(248, 243, 233, 0.2);
      }
      .btn-submit:hover { 
        background-color: #E5E5E5; transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.25) !important;
      }
      .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }

      footer {
        background-color: var(--surface-color); color: #888888; padding: 4rem 2.5rem 3rem;
        width: 100%; margin-top: auto; border-top: 1px solid var(--border-dark);
      }
      .footer-inner { max-width: 1400px; margin: 0 auto; }
      .copyright { color: #777777; font-size: 0.9rem; font-weight: 300; }
    </style>
  </head>
  <body>
    <header>
      <a href={`${base}/`} class="logo"><Image src={mainLogo} alt="Founder Frame" /></a>
    </header>

    <main class="container">
      <div class="form-card">
        <div class="progress-header">
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" id="progress-fill"></div>
          </div>
        </div>

        <p class="form-subtitle">Tell us about your brand so we can craft your custom strategy.</p>

        <form id="onboarding-form">
          <input type="hidden" name="access_key" value="942bdab6-88a9-40af-81e6-36e56933ddf7" />
          <input type="hidden" name="subject" value="New Client Onboarding Questionnaire Submission!" />
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

          <!-- STEP 1 -->
          <div class="form-step active" data-step="1">
            <div class="section-title">Contact & Brand Info</div>
            <div class="form-group">
              <label for="fullName">Your Full Name *</label>
              <input type="text" id="fullName" name="Full Name" placeholder="John Doe" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address *</label>
              <input type="email" id="email" name="Email Address" placeholder="john@example.com" required />
            </div>
            <div class="form-group">
              <label for="businessName">Business / Brand Name *</label>
              <input type="text" id="businessName" name="Business Name" placeholder="Business Inc." required />
            </div>
            <div class="nav-buttons">
              <div></div>
              <button type="button" class="btn-next" onclick="nextStep(1)">Next &rarr;</button>
            </div>
          </div>

          <!-- STEP 2 -->
          <div class="form-step" data-step="2">
            <div class="section-title">Section 1: Core Positioning & Offers</div>
            <div class="form-group">
              <label for="q1">What is the primary product or service you sell?</label>
              <textarea id="q1" name="1. Primary Product or Service" placeholder="Describe what you sell..."></textarea>
            </div>
            <div class="form-group">
              <label for="q2">What are some strong beliefs you hold about yourself and your industry?</label>
              <textarea id="q2" name="2. Industry Beliefs" placeholder="Share your core philosophies..."></textarea>
            </div>
            <div class="form-group">
              <label for="q3">What topics or personal details are off-limits for you on camera?</label>
              <textarea id="q3" name="3. Off-Limits Topics" placeholder="Boundaries or topics to avoid..."></textarea>
            </div>
            <div class="nav-buttons">
              <button type="button" class="btn-back" onclick="prevStep(2)">&larr; Back</button>
              <button type="button" class="btn-next" onclick="nextStep(2)">Next &rarr;</button>
            </div>
          </div>

          <!-- STEP 3 -->
          <div class="form-step" data-step="3">
            <div class="section-title">Section 2: Target Audience & Leads</div>
            <div class="form-group">
              <label for="q4">What is the biggest problem your ideal client is facing right now?</label>
              <textarea id="q4" name="4. Ideal Client Problem" placeholder="Pain points..."></textarea>
            </div>
            <div class="form-group">
              <label for="q5">What specific questions or objections do clients ask you on sales calls?</label>
              <textarea id="q5" name="5. Sales Call Objections" placeholder="Common questions..."></textarea>
            </div>
            <div class="form-group">
              <label for="q6">Where do you want viewers to go when they are ready to buy or reach out?</label>
              <input type="text" id="q6" name="6. Call to Action Destination" placeholder="Website link, calendar link, DM, etc." />
            </div>
            <div class="nav-buttons">
              <button type="button" class="btn-back" onclick="prevStep(3)">&larr; Back</button>
              <button type="button" class="btn-next" onclick="nextStep(3)">Next &rarr;</button>
            </div>
          </div>

          <!-- STEP 4 -->
          <div class="form-step" data-step="4">
            <div class="section-title">Section 3: Current Social Media Links</div>
            <div class="form-group">
              <label for="q7">Please link all of your current social media profiles:</label>
              <textarea id="q7" name="7. Social Media Links" placeholder="Instagram, TikTok, LinkedIn, YouTube, X, etc."></textarea>
            </div>
            <div class="nav-buttons">
              <button type="button" class="btn-back" onclick="prevStep(4)">&larr; Back</button>
              <button type="button" class="btn-next" onclick="nextStep(4)">Next &rarr;</button>
            </div>
          </div>

          <!-- STEP 5 -->
          <div class="form-step" data-step="5">
            <div class="section-title">Section 4: iPhone Setup & Production Realities</div>
            <div class="form-group">
              <label for="q8">Which iPhone model will you be using for your content?</label>
              <input type="text" id="q8" name="8. iPhone Model" placeholder="e.g. iPhone 15 Pro" />
            </div>
            <div class="form-group">
              <label for="q9">Where in your home or office can you consistently shoot with good natural light?</label>
              <textarea id="q9" name="9. Shooting Location" placeholder="Describe the spot..."></textarea>
            </div>
            <div class="form-group">
              <label for="q10">Do you currently own a lapel mic, tripod, or lighting setup?</label>
              <textarea id="q10" name="10. Current Equipment" placeholder="If yes, please list what you have..."></textarea>
            </div>
            <div class="form-group">
              <label for="heardAboutUs">How did you hear about us? *</label>
              <input type="text" id="heardAboutUs" name="How did you hear about us" placeholder="Instagram, referral, Google, etc." required />
            </div>
            <div class="nav-buttons" style="flex-direction: column; gap: 1rem;">
              <button type="submit" id="submit-btn" class="btn-submit">Get Blueprint &rarr;</button>
              <button type="button" class="btn-back" onclick="prevStep(5)" style="align-self: center;">&larr; Back</button>
            </div>
          </div>
        </form>
      </div>
    </main>

    <footer>
      <div class="footer-inner">
        <p class="copyright">&copy; 2026 Founder Frame. All rights reserved.</p>
      </div>
    </footer>

    <script define:vars={{ thankYouUrl }}>
      let currentStep = 1;
      const totalSteps = 5;

      function updateUI() {
        document.querySelectorAll('.form-step').forEach(step => {
          step.classList.remove('active');
        });
        document.querySelector(`.form-step[data-step="${currentStep}"]`).classList.add('active');

        const fillPct = (currentStep / totalSteps) * 100;
        document.getElementById('progress-fill').style.width = `${fillPct}%`;

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      window.nextStep = function(step) {
        if (step === 1) {
          const name = document.getElementById('fullName').value.trim();
          const email = document.getElementById('email').value.trim();
          const business = document.getElementById('businessName').value.trim();

          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

          if (!name || !email || !business) {
            alert('Please fill in your name, email, and business name to proceed.');
            return;
          }

          if (!emailRegex.test(email)) {
            alert('Please enter a valid email address.');
            return;
          }
        }
        if (currentStep < totalSteps) {
          currentStep++;
          updateUI();
        }
      };

      window.prevStep = function(step) {
        if (currentStep > 1) {
          currentStep--;
          updateUI();
        }
      };

      const form = document.getElementById('onboarding-form');
      const submitBtn = document.getElementById('submit-btn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Validate the required "How did you hear about us?" field before final submit
        const heardAboutUs = document.getElementById('heardAboutUs').value.trim();
        if (!heardAboutUs) {
          alert('Please let us know how you heard about us before submitting.');
          document.getElementById('heardAboutUs').focus();
          return;
        }

        submitBtn.textContent = 'Submitting...';
        submitBtn.disabled = true;

        const formData = new FormData(form);
        const object = Object.fromEntries(formData);
        const json = JSON.stringify(object);

        try {
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: json
          });

          const result = await response.json();

          if (result.success) {
            window.location.href = thankYouUrl;
          } else {
            alert(result.message || 'Something went wrong. Please try again.');
            submitBtn.textContent = 'Get Blueprint \u2192';
            submitBtn.disabled = false;
          }
        } catch (error) {
          alert('Network error. Please check your connection and try again.');
          submitBtn.textContent = 'Get Blueprint \u2192';
          submitBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>