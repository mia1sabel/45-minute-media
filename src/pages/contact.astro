---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Get Started | 45-Minute Media</title>
    <style>
      /* Keeping global styles identical */
      :root { --bg-color: #FFFFFF; --text-color: #1A1A1A; --border-color: #E5E7EB; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; display: flex; flex-direction: column; min-height: 100vh; }
      
      header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid var(--border-color); }
      .logo-container img { height: 35px; width: auto; }
      nav { display: flex; gap: 2rem; }
      nav a { text-decoration: none; color: #6B7280; font-size: 0.95rem; transition: color 0.2s; }
      nav a:hover, nav a.active { color: var(--text-color); font-weight: 500; }

      main { flex: 1; width: 100%; max-width: 800px; margin: 0 auto; padding: 4rem 2rem; }
      h1 { font-size: 2.5rem; font-weight: 600; margin-bottom: 1rem; letter-spacing: -0.02em; }
      p { font-size: 1.05rem; color: #374151; margin-bottom: 2rem; }

      .terminal-block { background-color: #111827; border-radius: 12px; overflow: hidden; margin-top: 2rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
      .terminal-header { background-color: #1F2937; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: #9CA3AF; font-family: monospace; }
      .terminal-body { padding: 2rem 1.5rem; display: flex; align-items: center; }
      
      .contact-email { color: #60A5FA; text-decoration: none; font-family: monospace; font-size: 1.2rem; transition: color 0.2s; }
      .contact-email:hover { color: #93C5FD; text-decoration: underline; }
      .terminal-prompt { color: #10B981; margin-right: 1rem; font-family: monospace; font-size: 1.2rem;}

      footer { text-align: center; padding: 2rem; font-size: 0.85rem; color: #9CA3AF; border-top: 1px solid var(--border-color); }
    </style>
  </head>
  <body>
    
    <header>
      <div class="logo-container">
        <a href="/"><Image src={mainLogo} alt="45-Minute Media Logo" /></a>
      </div>
      <nav>
        <a href="/">Home</a>
        <a href="/work">Work</a>
        <a href="/contact" class="active">Get Started</a>
      </nav>
    </header>

    <main>
      <h1>Step 3: Initialize Contact</h1>
      <p>Skip the endless meetings. Run the command below to send us an email with a brief overview of your project, and we will return a direct quote and scheduling options.</p>

      <div class="terminal-block">
        <div class="terminal-header">
          <span>Mailto</span>
          <span>&#9660; &#9744;</span>
        </div>
        <div class="terminal-body">
          <span class="terminal-prompt">&gt;</span>
          <a href="mailto:45minutemedia@gmail.com" class="contact-email">45minutemedia@gmail.com</a>
        </div>
      </div>
    </main>

    <footer>
      <p>&copy; 2026 45-Minute Media. All rights reserved.</p>
    </footer>

  </body>
</html>