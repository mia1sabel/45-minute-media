---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Get Started | 45-Minute Media</title>
    <style>
      :root { --bg-color: #FAFAFA; --text-main: #111827; --text-muted: #6B7280; --accent: #2563EB; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background-color: var(--bg-color); color: var(--text-main); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
      
      header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 5%; max-width: 1400px; margin: 0 auto; width: 100%; }
      .logo { display: flex; align-items: center; }
      .logo img { height: 60px; width: auto; max-height: 60px; object-fit: contain; }
      nav { display: flex; gap: 2.5rem; align-items: center; }
      nav a { text-decoration: none; color: var(--text-muted); font-weight: 500; font-size: 0.95rem; transition: color 0.2s ease; }
      nav a:hover, nav a.active { color: var(--text-main); }

      /* Contact Card Layout */
      main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem 5%; }
      .contact-card {
        background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 16px;
        padding: 3.5rem 2.5rem; max-width: 540px; width: 100%; text-align: center;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.04);
      }
      h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
      p { color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 2rem; }
      
      .email-link {
        font-size: 1.15rem; font-weight: 600; color: var(--text-main);
        text-decoration: none; border-bottom: 2px solid var(--accent);
        padding-bottom: 0.25rem; transition: color 0.2s ease, border-color 0.2s ease;
      }
      .email-link:hover { color: var(--accent); }

      /* Black Footer */
      footer {
        background-color: #000000; text-align: center; padding: 3rem 5%;
        font-size: 0.875rem; color: #9CA3AF; width: 100%; margin-top: auto;
        display: flex; flex-direction: column; align-items: center; gap: 0.75rem;
      }
      footer a { color: #FFFFFF; text-decoration: none; font-weight: 500; }
      footer a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href="/">Home</a>
        <a href="/work">Work</a>
        <a href="/contact" class="active">Get Started</a>
      </nav>
    </header>

    <main>
      <div class="contact-card">
        <h1>Ready to roll?</h1>
        <p>Skip the endless meetings. Send us an email with a brief overview of your project, and we will get back to you with a direct quote and scheduling options.</p>
        <a href="mailto:45minutemedia@gmail.com" class="email-link">45minutemedia@gmail.com</a>
      </div>
    </main>

    <footer>
      <p>Contact: <a href="mailto:45minutemedia@gmail.com">45minutemedia@gmail.com</a></p>
      <p>&copy; 2026 45-Minute Media. All rights reserved.</p>
    </footer>
  </body>
</html>