---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Get Started | 45-Minute Media</title>
    <style>
      :root { --bg-color: #FAFAFA; --text-main: #111827; --text-muted: #6B7280; --accent: #2563EB; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background-color: var(--bg-color); color: var(--text-main); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
      
      header { display: flex; justify-content: space-between; align-items: center; padding: 2rem 5%; max-width: 1280px; margin: 0 auto; width: 100%; }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 72px; width: auto; object-fit: contain; }
      nav { display: flex; gap: 2rem; align-items: center; }
      nav a { text-decoration: none; color: var(--text-muted); font-weight: 500; font-size: 1rem; transition: color 0.2s ease; }
      nav a:hover, nav a.active { color: var(--text-main); }

      main { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem 5% 5rem; }
      .container { max-width: 580px; width: 100%; }

      /* Limited Time Offer Callout Box (Concise 2 Lines) */
      .offer-banner {
        background-color: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 12px;
        padding: 1.25rem 1.5rem; margin-bottom: 2rem; text-align: left;
      }
      .offer-badge {
        display: inline-block; background: #2563EB; color: #FFF;
        font-size: 0.7rem; font-weight: 700; padding: 0.2rem 0.5rem;
        border-radius: 4px; text-transform: uppercase; margin-bottom: 0.5rem;
      }
      .offer-text { font-size: 0.95rem; color: #1E40AF; line-height: 1.45; }
      .offer-text strong { color: #1E3A8A; font-weight: 700; }

      /* Form styling */
      .form-card {
        background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 16px;
        padding: 2.5rem; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
      }
      .form-card h1 { font-size: 1.75rem; font-weight: 800; margin-bottom: 1.5rem; letter-spacing: -0.02em; color: #111827; }
      
      .form-group { display: flex; flex-direction: column; gap: 0.4rem; margin-bottom: 1.25rem; text-align: left; }
      .form-group label { font-size: 0.875rem; font-weight: 600; color: #374151; }
      .form-group input {
        padding: 0.85rem 1rem; border: 1px solid #D1D5DB; border-radius: 8px;
        font-size: 0.95rem; font-family: inherit; transition: border-color 0.2s, box-shadow 0.2s;
        outline: none; background-color: #FAFAFA;
      }
      .form-group input:focus { border-color: var(--accent); background-color: #FFF; box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15); }
      
      .submit-btn {
        width: 100%; background-color: #0F172A; color: #FFF; border: none;
        padding: 0.95rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem;
        cursor: pointer; transition: background-color 0.2s ease, transform 0.1s ease; margin-top: 0.5rem;
      }
      .submit-btn:hover { background-color: #1E293B; transform: translateY(-1px); }

      /* Unified Dark Footer */
      footer {
        background-color: #050505; color: #9CA3AF; padding: 4rem 5% 3rem;
        width: 100%; margin-top: auto;
      }
      .footer-inner {
        max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;
      }
      .footer-brand .footer-logo img { height: 56px; width: auto; display: block; margin-bottom: 1rem; }
      .footer-tagline { font-size: 0.95rem; color: #9CA3AF; }
      .footer-divider { height: 1px; background-color: #1F2937; width: 100%; }
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.875rem;
      }
      .footer-nav { display: flex; gap: 2rem; }
      .footer-nav a { color: #D1D5DB; text-decoration: none; font-weight: 500; transition: color 0.2s; }
      .footer-nav a:hover { color: #FFF; }
      .copyright { color: #6B7280; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href="/">Home</a>
        <a href="/work">Work</a>
        <a href="/contact" class="active">Get Started</a>
      </nav>
    </header>

    <main>
      <div class="container">
        <!-- 2-Line Offer Banner -->
        <div class="offer-banner">
          <span class="offer-badge">Limited Availability</span>
          <p class="offer-text">
            We cap our roster at 3 clients to guarantee quality — <strong>we currently have 1 open spot.</strong><br />
            Fill out the form below for a quick call, and we’ll script and edit your first video for free! 🎥
          </p>
        </div>

        <!-- Clean Form Card -->
        <div class="form-card">
          <h1>Get Started</h1>
          <form action="#" method="POST" onsubmit="event.preventDefault(); alert('Form submitted!');">
            <div class="form-group">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" placeholder="John Doe" required />
            </div>

            <div class="form-group">
              <label for="business">Business Name</label>
              <input type="text" id="business" name="business" placeholder="Acme Inc." required />
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" placeholder="john@example.com" required />
            </div>

            <div class="form-group">
              <label for="website">Website</label>
              <input type="url" id="website" name="website" placeholder="https://example.com" />
            </div>

            <button type="submit" class="submit-btn">Claim Your Free Video Session</button>
          </form>
        </div>
      </div>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
          <p class="footer-tagline">Video content for social media, made simple.</p>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <div class="footer-nav">
            <a href="/">Home</a>
            <a href="/work">Work</a>
            <a href="/contact">Get Started</a>
          </div>
          <p class="copyright">&copy; 2026 45-Minute Media. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>