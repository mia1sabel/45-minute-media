---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
import faviconImg from '../assets/Circle Logo SVG transparent.svg';

const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work | 45-Minute Media</title>
    <style>
      :root {
        --bg-color: #FAFAFA;
        --text-main: #111827;
        --text-muted: #6B7280;
        --accent: #2563EB;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }

      /* Header Styling */
      header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 5%; width: 100%; max-width: 1400px; margin: 0 auto;
        border-bottom: 1px solid #E5E7EB;
      }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 90px; width: auto; object-fit: contain; }

      nav { display: flex; gap: 1.25rem; align-items: center; }
      nav a {
        text-decoration: none; color: var(--text-muted); font-weight: 600;
        font-size: 0.95rem; transition: color 0.2s ease; white-space: nowrap;
      }
      nav a:hover, nav a.active { color: var(--text-main); }

      /* Mobile Header Fix */
      @media (max-width: 640px) {
        header { flex-direction: column; gap: 1rem; padding: 1rem 5%; }
        .logo img { height: 65px; }
        nav { gap: 1.5rem; }
      }

      main { flex: 1; padding: 3rem 5%; max-width: 1200px; margin: 0 auto; width: 100%; }
      .page-header { margin-bottom: 2.5rem; text-align: center; }
      h1 { font-size: 2.5rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
      .page-subtitle { color: var(--text-muted); font-size: 1.1rem; font-weight: 500; }

      .grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
      @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 2.5rem; } }

      .project-card { display: flex; flex-direction: column; gap: 1rem; }
      .vertical-placeholder-wrapper {
        width: 100%; aspect-ratio: 9/16; background-color: #0F172A;
        border-radius: 16px; border: 2px dashed #334155;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 2rem; text-align: center; color: #94A3B8;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
      }
      .placeholder-icon {
        width: 48px; height: 48px; margin-bottom: 1rem; opacity: 0.6; stroke: #94A3B8;
      }
      .placeholder-title { font-size: 1.1rem; font-weight: 700; color: #F8FAFC; margin-bottom: 0.25rem; }
      .placeholder-desc { font-size: 0.9rem; color: #64748B; }

      /* Footer */
      footer {
        background-color: #050505; color: #9CA3AF; padding: 4rem 5% 3rem;
        width: 100%; margin-top: auto;
      }
      .footer-inner {
        max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;
      }
      .footer-brand .footer-logo img { height: 110px; width: auto; display: block; margin-bottom: 1rem; }
      .footer-tagline { font-size: 1rem; color: #9CA3AF; }
      .footer-divider { height: 1px; background-color: #1F2937; width: 100%; }
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.95rem;
      }
      .footer-nav { display: flex; gap: 2rem; }
      .footer-nav a { color: #D1D5DB; text-decoration: none; font-weight: 500; transition: color 0.2s; }
      .footer-nav a:hover { color: #FFF; }
      .copyright { color: #6B7280; }
    </style>
  </head>
  <body>
    <header>
      <a href={`${base}/`} class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/work`} class="active">Work</a>
        <a href={`${base}/contact`}>Get Started</a>
      </nav>
    </header>

    <main>
      <div class="page-header">
        <h1>Exemplary Work</h1>
        <p class="page-subtitle">Built for Instagram Reels, TikTok, and YouTube Shorts.</p>
      </div>

      <div class="grid">
        <div class="project-card">
          <div class="vertical-placeholder-wrapper">
            <svg class="placeholder-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5m-3-12h13.5c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125H5.25A1.125 1.125 0 0 1 4.125 18V6c0-.621.504-1.125 1.125-1.125Z" />
            </svg>
            <p class="placeholder-title">Video Placeholder 1</p>
            <p class="placeholder-desc">Add video content here later</p>
          </div>
        </div>

        <div class="project-card">
          <div class="vertical-placeholder-wrapper">
            <svg class="placeholder-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25v13.5m-7.5-13.5v13.5m-3-12h13.5c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125H5.25A1.125 1.125 0 0 1 4.125 18V6c0-.621.504-1.125 1.125-1.125Z" />
            </svg>
            <p class="placeholder-title">Video Placeholder 2</p>
            <p class="placeholder-desc">Add video content here later</p>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href={`${base}/`} class="footer-logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
          <p class="footer-tagline">Video content for social media, made simple.</p>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <div class="footer-nav">
            <a href={`${base}/`}>Home</a>
            <a href={`${base}/work`}>Work</a>
            <a href={`${base}/contact`}>Get Started</a>
          </div>
          <p class="copyright">&copy; 2026 45-Minute Media. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>