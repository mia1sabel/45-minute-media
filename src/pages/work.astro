---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Work | 45-Minute Media</title>
    <style>
      /* Keeping global styles identical */
      :root { --bg-color: #FFFFFF; --text-color: #1A1A1A; --border-color: #E5E7EB; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: var(--bg-color); color: var(--text-color); line-height: 1.6; display: flex; flex-direction: column; min-height: 100vh; }
      
      header { display: flex; justify-content: space-between; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid var(--border-color); }
      .logo-container img { height: 35px; width: auto; }
      nav { display: flex; gap: 2rem; }
      nav a { text-decoration: none; color: #6B7280; font-size: 0.95rem; transition: color 0.2s; }
      nav a:hover, nav a.active { color: var(--text-color); font-weight: 500; }

      main { flex: 1; width: 100%; max-width: 800px; margin: 0 auto; padding: 4rem 2rem; }
      h1 { font-size: 2.5rem; font-weight: 600; margin-bottom: 2rem; letter-spacing: -0.02em; }
      p { font-size: 1.05rem; color: #374151; margin-bottom: 1.5rem; }

      /* Video Terminal Blocks */
      .terminal-block { background-color: #111827; border-radius: 12px; overflow: hidden; margin-bottom: 3rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
      .terminal-header { background-color: #1F2937; padding: 0.75rem 1rem; display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: #9CA3AF; font-family: monospace; }
      .video-wrapper { background: #000; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; color: #4B5563; font-family: monospace; }
      .video-caption { padding: 1rem 1.5rem; color: #E5E7EB; font-family: monospace; font-size: 0.9rem; border-top: 1px solid #374151; }

      footer { text-align: center; padding: 2rem; font-size: 0.85rem; color: #9CA3AF; border-top: 1px solid var(--border-color); }
    </style>
  </head>
  <body>
    
    <header>
      <div class="logo-container">
        <a href="/"><Image src={mainLogo} alt="45-Minute Media Logo" /></a>
      </div>
      <nav>
        <a href="/">Home</a>
        <a href="/work" class="active">Work</a>
        <a href="/contact">Get Started</a>
      </nav>
    </header>

    <main>
      <h1>Step 2: Verify the Output</h1>
      <p>Once the production finishes, let's make sure the assets are exactly what your brand needs before we push to live. Review the output below:</p>

      <div class="terminal-block">
        <div class="terminal-header">
          <span>Brand_Documentary.mp4</span>
          <span>&#9660; &#9744;</span>
        </div>
        <div class="video-wrapper">
          [ Insert Example Video 1 Embed Here ]
        </div>
        <div class="video-caption">
          > execution_time: 45ms<br>
          > status: Approved
        </div>
      </div>

      <div class="terminal-block">
        <div class="terminal-header">
          <span>Social_Campaign_Optimized.mp4</span>
          <span>&#9660; &#9744;</span>
        </div>
        <div class="video-wrapper">
          [ Insert Example Video 2 Embed Here ]
        </div>
        <div class="video-caption">
          > execution_time: 45ms<br>
          > status: Approved
        </div>
      </div>
    </main>

    <footer>
      <p>&copy; 2026 45-Minute Media. All rights reserved.</p>
    </footer>

  </body>
</html>