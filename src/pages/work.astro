---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work | 45-Minute Media</title>
    <style>
      :root { --bg-color: #FAFAFA; --text-main: #111827; --text-muted: #6B7280; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background-color: var(--bg-color); color: var(--text-main); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
      
      header { display: flex; justify-content: space-between; align-items: center; padding: 2.5rem 5%; max-width: 1280px; margin: 0 auto; width: 100%; }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 110px; width: auto; object-fit: contain; }
      
      nav { display: flex; gap: 2.5rem; align-items: center; }
      nav a { text-decoration: none; color: var(--text-muted); font-weight: 600; font-size: 1.05rem; transition: color 0.2s ease; }
      nav a:hover, nav a.active { color: var(--text-main); }

      main { flex: 1; padding: 4rem 5%; max-width: 960px; margin: 0 auto; width: 100%; }
      .page-header { margin-bottom: 3.5rem; text-align: center; }
      h1 { font-size: 2.75rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem; }
      .page-subtitle { color: var(--text-muted); font-size: 1.2rem; font-weight: 500; }

      .grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
      @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
      
      .project-card { display: flex; flex-direction: column; gap: 1rem; }
      .vertical-video-wrapper { 
        width: 100%; aspect-ratio: 9/16; background-color: #111827; 
        border-radius: 16px; overflow: hidden;
        box-shadow: 0 10px 20px -5px rgba(0, 0, 0, 0.1);
        display: flex; align-items: center; justify-content: center;
      }
      .vertical-video-wrapper video {
        width: 100%; height: 100%; object-fit: cover; display: block;
      }
      .project-info h3 { font-size: 1.25rem; font-weight: 700; margin-bottom: 0.25rem; }
      .project-info p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.4; }

      /* Dark Footer */
      footer {
        background-color: #050505; color: #9CA3AF; padding: 4rem 5% 3rem;
        width: 100%; margin-top: auto;
      }
      .footer-inner {
        max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem;
      }
      .footer-brand .footer-logo img { height: 90px; width: auto; display: block; margin-bottom: 1rem; }
      .footer-tagline { font-size: 1rem; color: #9CA3AF; }
      .footer-divider { height: 1px; background-color: #1F2937; width: 100%; }
      .footer-bottom {
        display: flex; justify-content: space-between; align-items: center;
        flex-wrap: wrap; gap: 1rem; font-size: 0.95rem;
      }
      .footer-nav { display: flex; gap: 2rem; }
      .footer-nav a { color: #D1D5DB; text-decoration: none; font-weight: 500; transition: color 0.2s; }
      .footer-nav a:hover { color: #FFF; }
      .copyright { color: #6B7280; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href="/">Home</a>
        <a href="/work" class="active">Work</a>
        <a href="/contact">Get Started</a>
      </nav>
    </header>

    <main>
      <div class="page-header">
        <h1>Featured Work</h1>
        <!-- Updated Subtitle -->
        <p class="page-subtitle">Built for Instagram Reels, TikTok, and YouTube Shorts.</p>
      </div>

      <div class="grid">
        <div class="project-card">
          <div class="vertical-video-wrapper">
            <video controls poster="/real-estate-thumb.jpg">
              <source src="/real-estate.mp4" type="video/mp4" />
              Real Estate Showcase
            </video>
          </div>
          <div class="project-info">
            <h3>Real Estate Showcase</h3>
            <p>Property walkthrough created for social feed retention.</p>
          </div>
        </div>
        
        <div class="project-card">
          <div class="vertical-video-wrapper">
            <video controls poster="/wip-thumb.jpg">
              <source src="/wip-project.mp4" type="video/mp4" />
              Work In Progress
            </video>
          </div>
          <div class="project-info">
            <h3>Work in Progress</h3>
            <p>Behind the scenes client highlight coming soon.</p>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="footer-logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
          <p class="footer-tagline">Video content for social media, made simple.</p>
        </div>
        <div class="footer-divider"></div>
        <div class="footer-bottom">
          <div class="footer-nav">
            <a href="/">Home</a>
            <a href="/work">Work</a>
            <a href="/contact">Get Started</a>
          </div>
          <p class="copyright">&copy; 2026 45-Minute Media. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>