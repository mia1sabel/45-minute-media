---
import { Image } from 'astro:assets';
import mainLogo from '../assets/Rectangle Logo SVG transparent.svg';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Work | 45-Minute Media</title>
    <style>
      :root { --bg-color: #FAFAFA; --text-main: #111827; --text-muted: #6B7280; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background-color: var(--bg-color); color: var(--text-main); -webkit-font-smoothing: antialiased; display: flex; flex-direction: column; min-height: 100vh; }
      
      header { display: flex; justify-content: space-between; align-items: center; padding: 2rem 5%; max-width: 1400px; margin: 0 auto; width: 100%; }
      .logo img { height: 42px; width: auto; }
      nav { display: flex; gap: 2.5rem; }
      nav a { text-decoration: none; color: var(--text-muted); font-weight: 500; font-size: 0.95rem; transition: color 0.2s ease; }
      nav a:hover, nav a.active { color: var(--text-main); }

      main { flex: 1; padding: 4rem 5%; max-width: 1200px; margin: 0 auto; width: 100%; }
      .page-header { margin-bottom: 4rem; text-align: center; }
      h1 { font-size: 3rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 1rem; }
      .page-subtitle { color: var(--text-muted); font-size: 1.15rem; }

      /* Elegant Video Grid */
      .grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
      @media (min-width: 768px) { .grid { grid-template-columns: repeat(2, 1fr); } }
      
      .project-card { display: flex; flex-direction: column; gap: 1rem; }
      .video-placeholder { 
        width: 100%; aspect-ratio: 16/9; background-color: #E5E7EB; 
        border-radius: 12px; display: flex; align-items: center; 
        justify-content: center; color: var(--text-muted); font-size: 0.9rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }
      .project-info h3 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.25rem; }
      .project-info p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; }

      footer { text-align: center; padding: 3rem 5%; font-size: 0.875rem; color: var(--text-muted); }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="logo"><Image src={mainLogo} alt="45-Minute Media" /></a>
      <nav>
        <a href="/">Home</a>
        <a href="/work" class="active">Work</a>
        <a href="/contact">Get Started</a>
      </nav>
    </header>

    <main>
      <div class="page-header">
        <h1>Featured Projects</h1>
        <p class="page-subtitle">A selection of our recent productions.</p>
      </div>

      <div class="grid">
        <div class="project-card">
          <div class="video-placeholder">[ Video 1 Embed ]</div>
          <div class="project-info">
            <h3>Brand Documentary</h3>
            <p>Showcasing company culture and values with cinematic precision.</p>
          </div>
        </div>
        
        <div class="project-card">
          <div class="video-placeholder">[ Video 2 Embed ]</div>
          <div class="project-info">
            <h3>Social Campaign</h3>
            <p>Fast-paced, optimized for maximum engagement across platforms.</p>
          </div>
        </div>
      </div>
    </main>

    <footer>
      <p>&copy; 2026 45-Minute Media. All rights reserved.</p>
    </footer>
  </body>
</html>