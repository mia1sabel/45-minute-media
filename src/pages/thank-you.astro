---
import { Image } from 'astro:assets';
import mainLogo from '../assets/1.png';
import faviconImg from '../assets/3.svg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={faviconImg.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thank You | Founder Frame</title>

    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&display=swap" rel="stylesheet">

    <style>
      :root {
        --bg-color: #F8F3E9;
        --text-main: #000000;
        --grid-line-light: rgba(0, 0, 0, 0.15);
      }

      html { scroll-behavior: smooth; }
      * { box-sizing: border-box; margin: 0; padding: 0; border-radius: 0 !important; }

      body {
        font-family: 'Inter', sans-serif;
        background-color: var(--bg-color);
        color: var(--text-main);
        -webkit-font-smoothing: antialiased;
        display: flex; flex-direction: column; min-height: 100vh;
      }

      header {
        position: relative;
        background-color: transparent;
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 3rem; width: 100%;
        border-bottom: 2px solid var(--grid-line-light);
      }
      .logo { display: flex; align-items: center; text-decoration: none; }
      .logo img { height: 75px; width: auto; object-fit: contain; display: block; }

      .thank-you-main {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 4rem 1.5rem;
      }

      .thank-you-container {
        background-color: #0D0D0C;
        color: #F8F3E9;
        width: 100%;
        max-width: 680px;
        padding: 3.5rem;
        /* Exact card styling & multi-stage shadow matching the onboarding form */
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 
          0 10px 30px -5px rgba(0, 0, 0, 0.15),
          0 20px 50px -10px rgba(0, 0, 0, 0.25),
          0 30px 90px 0px rgba(0, 0, 0, 0.3) !important;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        text-align: center;
        align-items: center;
      }

      .thank-you-header-line {
        width: 40px;
        height: 2px;
        background-color: rgba(255, 255, 255, 0.3);
      }

      .title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 3vw, 2.5rem);
        font-weight: 500;
        color: #F8F3E9;
        line-height: 1.2;
      }

      .message {
        font-size: 1.05rem;
        color: #B3B0A7;
        font-weight: 300;
        line-height: 1.6;
        max-width: 520px;
      }

      .action-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        max-width: 320px;
        margin-top: 0.5rem;
      }

      /* SOFT INTERACTIVE FOCUS GLOW RING & BUTTONS */
      .blueprint-btn, .home-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 1.1rem 2rem;
        text-decoration: none;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        transition: all 0.25s ease;
      }

      .blueprint-btn {
        background-color: #F8F3E9;
        color: #000000;
      }

      .blueprint-btn:hover,
      .blueprint-btn:focus {
        background-color: #FFFFFF;
        outline: none;
        border-color: rgba(255, 255, 255, 0.6);
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.25) !important;
      }

      .home-btn {
        background-color: transparent;
        color: #B3B0A7;
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      .home-btn:hover,
      .home-btn:focus {
        color: #FFFFFF;
        border-color: rgba(255, 255, 255, 0.4);
        outline: none;
        box-shadow: 0 0 15px rgba(255, 255, 255, 0.15) !important;
      }

      footer {
        background-color: #0A0A0A; color: #888888; padding: 3rem;
        width: 100%; border-top: 2px solid rgba(255, 255, 255, 0.15);
        text-align: center; font-size: 0.85rem;
      }
    </style>
  </head>
  <body>
    <header>
      <a href={`${base}/`} class="logo"><Image src={mainLogo} alt="Founder Frame" /></a>
    </header>

    <main class="thank-you-main">
      <div class="thank-you-container">
        <div class="thank-you-header-line"></div>
        <h1 class="title">Thank You</h1>
        <p class="message">
          Your responses have been submitted successfully to our team.
        </p>
        <div class="action-buttons">
          <a href={`${base}/founder-frame-blueprint.pdf`} download="founder-frame-blueprint.pdf" class="blueprint-btn">Download The Blueprint</a>
          <a href={`${base}/`} class="home-btn">Return Home</a>
        </div>
      </div>
    </main>

    <footer>
      <p>&copy; 2026 Founder Frame. All rights reserved.</p>
    </footer>
  </body>
</html>